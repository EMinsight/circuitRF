<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.AcknowledgmentsWindow"
        Title="Acknowledgments"
        Width="480"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="20">

        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="8">

                <TextBlock Text="Open Source Libraries"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">Avalonia</Run>
                    <Run> — Cross-platform UI framework for .NET. MIT License.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">CommunityToolkit.Mvvm</Run>
                    <Run> — MVVM helpers for .NET. MIT License.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">SkiaSharp</Run>
                    <Run> — Cross-platform 2D graphics API. MIT License.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">Dock.Avalonia / Dock.Model.Mvvm</Run>
                    <Run> — Docking library for Avalonia. MIT License.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">Material.Icons.Avalonia</Run>
                    <Run> — Material Design icon set for Avalonia. MIT License.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">CSparse.NET</Run>
                    <Run> — Sparse matrix library for .NET. © Christian Woltering. LGPL v2.1 only.</Run>
                    <LineBreak/>
                    <Run Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="11">Linked statically into this build. LGPL §6 gives you the right to modify CSparse.NET and relink it into a working circuitRF; complete source for doing so is published at the project repository. See THIRD-PARTY-NOTICES.md.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">Open CASCADE Technology</Run>
                    <Run> — The modelling kernel behind booleans, fillets and STEP. © Matra Datavision and OPEN CASCADE SAS. LGPL v2.1 only, with the Open CASCADE Exception 1.0.</Run>
                    <LineBreak/>
                    <Run Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="11">circuitRF uses facilities provided by Open CASCADE Technology. Its libraries ship unmodified and dynamically linked, in the geometry-kernel folder beside the application, where a modified build can replace them. The source is available under the written offer in THIRD-PARTY-NOTICES.md.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">NumFlat</Run>
                    <Run> — Dense linear algebra for .NET. MIT License.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">FftFlat</Run>
                    <Run> — Fast Fourier transform for .NET. MIT License.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">Clipper2</Run>
                    <Run> — Integer-coordinate polygon clipping and offsetting, used by the layout editor. Boost Software License.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">gdstk</Run>
                    <Run> — Reads and writes OASIS and GDSII for the (gdstk) import and export commands. © Lucas Heitzmann Gabrielli. Boost Software License. It carries Clipper 6.4.2 (© Angus Johnson, Boost Software License).</Run>
                    <LineBreak/>
                    <Run Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="11">Linked statically, with Qhull and zlib, into the one program in the gdstk-kernel folder beside the application.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">Qhull</Run>
                    <Run> — Convex hulls, used by gdstk. © C.B. Barber and The Geometry Center, University of Minnesota. Qhull licence; its original source code may be obtained from www.qhull.org.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">zlib</Run>
                    <Run> — Compression, used by gdstk for OASIS. © Jean-loup Gailly and Mark Adler. zlib licence.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">PureHDF</Run>
                    <Run> — HDF5 library for .NET. MIT License.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">Markdig</Run>
                    <Run> — Markdown processor for .NET. BSD-2-Clause License.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">Svg / Svg.Skia</Run>
                    <Run> — SVG rasterisation, used when generating application icons. Microsoft Public License (MS-PL) and MIT License respectively.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">osdi.h</Run>
                    <Run> — OSDI ABI header from the ngspice OSDI component, used by the OSDI device worker. © 2022 SemiMod GmbH. Mozilla Public License 2.0.</Run>
                </TextBlock>

                <TextBlock Text="Fonts" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,4"/>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                    <Run FontWeight="SemiBold">DejaVu Sans</Run>
                    <Run> — Derivative of Bitstream Vera Sans, with extended Unicode coverage.</Run>
                    <LineBreak/>
                    <Run Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="11">Fonts © Bitstream Inc. DejaVu changes are in the public domain. Arev glyphs © Tavmjong Bah. Bitstream Vera Fonts License.</Run>
                    <LineBreak/>
                    <Run Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="11">Embedded at: Assets/Fonts/DejaVuSans*.ttf</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,6,0,0">
                    <Run FontWeight="SemiBold">IBM Plex Sans</Run>
                    <Run> — IBM's open-source typeface family. Static variants embedded for SkiaSharp compatibility.</Run>
                    <LineBreak/>
                    <Run Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="11">© 2017 IBM Corp. SIL Open Font License, Version 1.1.</Run>
                    <LineBreak/>
                    <Run Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="11">Embedded at: Assets/Fonts/IBM_Plex_Sans/static/IBMPlexSans-*.ttf</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,6,0,0">
                    <Run FontWeight="SemiBold">Inter</Run>
                    <Run> — Supplied by Avalonia.Fonts.Inter and used by the generated user documentation.</Run>
                    <LineBreak/>
                    <Run Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="11">© The Inter Project Authors. SIL Open Font License, Version 1.1.</Run>
                </TextBlock>

                <TextBlock TextWrapping="Wrap" FontSize="11" LineHeight="16" Margin="0,14,0,0"
                           Foreground="{DynamicResource SystemBaseMediumColor}">
                    <Run>Full terms for every component above, including redistribution obligations, are in THIRD-PARTY-NOTICES.md, which is installed beside the application and is at the root of the circuitRF repository.</Run>
                </TextBlock>

            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1"
                Content="Close"
                IsDefault="True"
                Width="90"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Click="OnCloseClicked"
                FontSize="12"/>

    </Grid>
</Window>
