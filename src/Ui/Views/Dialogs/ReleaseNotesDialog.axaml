<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.ReleaseNotesDialog"
        Title="Release Notes"
        Width="720"
        Height="560"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <!--
    Two ways in, one window. At launch it opens once, the first time a newly installed version is
    run — never on a clean system and never twice for the same version, all of which ReleaseNotesGate
    owns and this window owns none of. From Help ▸ Release Notes… it opens on request, with the last
    few published releases whatever versions they are; there the heading names no single version, so
    every section carries its own banner (see Render).

    The notes are ONE SelectableTextBlock, not a list of per-line controls: the owner's requirement is
    that a user can drag a selection across many lines and copy it in one go, and a selection cannot
    cross two controls. Bold, italics, bullets and indentation are therefore inlines within it
    (SmallMarkdown produces the runs; the code-behind turns them into Inlines), and the
    indentation is non-breaking spaces for the same reason — there is nowhere else to put a margin.

    That rule is what decides the SHAPE of the skipped-versions list too: several releases' notes go
    into this one block, newest at the top and each under its own version banner, rather than into an
    ItemsControl of one block per release — which would look identical and break the drag.
  -->

  <Grid RowDefinitions="Auto,*,Auto" Margin="16,14,16,12">

    <!-- Which version these notes are for. Always shown, including on the two failure forms, because
         "we could not fetch them" is only actionable if you know what was being asked for. -->
    <TextBlock Grid.Row="0" Name="HeadingText" Text="Release Notes"
               FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

    <Border Grid.Row="1"
            BorderBrush="{DynamicResource ThemeBorderMidBrush}"
            BorderThickness="1"
            CornerRadius="4"
            ClipToBounds="True">
      <!-- The inset is the text block's MARGIN, never the ScrollViewer's Padding. A padded
           ScrollViewer measures its child at full height but arranges it shorter by the vertical
           padding, and a TextBlock rebuilds its layout at arrange time with that height as its
           MaxHeight — so the last line or two (20 px of padding, 18 px lines) were silently
           discarded from every showing. A margin is applied identically in measure and arrange. -->
      <ScrollViewer Name="NotesScroll"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <SelectableTextBlock Name="NotesText"
                             Margin="12,10"
                             TextWrapping="Wrap"
                             FontSize="12"
                             LineHeight="18"
                             VerticalAlignment="Top"
                             HorizontalAlignment="Stretch"/>
      </ScrollViewer>
    </Border>

    <!-- Bottom bar. The checkbox is at the LEFT, per the owner's own layout; it writes the preference
         the moment it changes, so there is no OK/Cancel asymmetry to explain. It belongs to the
         AUTOMATIC showing alone and the code-behind hides it on the Help ▸ Release Notes… form —
         that one opens whatever the preference says, so a checkbox there would be about a different
         showing than the window carrying it. -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">

      <CheckBox Grid.Column="0" Name="AlwaysShowCheck"
                Content="Always Show New Release Notes"
                FontSize="12"
                VerticalAlignment="Center"
                IsCheckedChanged="OnAlwaysShowChanged"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <!-- Only on a failure form: somewhere to go when we could not fetch the notes ourselves. -->
        <Button Name="BrowseButton" Content="Open Releases Page…" FontSize="12"
                IsVisible="False" Click="OnBrowseClicked"/>
        <Button Content="Close" Width="90" IsDefault="True" IsCancel="True"
                FontSize="12" Click="OnCloseClicked"/>
      </StackPanel>
    </Grid>

  </Grid>
</Window>
