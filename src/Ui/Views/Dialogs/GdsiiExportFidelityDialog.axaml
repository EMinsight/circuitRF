<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.GdsiiExportFidelityDialog"
        Title="Export GDSII"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,Auto" Margin="20,16,20,16">

        <StackPanel Grid.Row="0" Spacing="8">
            <SelectableTextBlock Text="This export will change the design as follows:" FontSize="12" FontWeight="SemiBold"/>

            <SelectableTextBlock x:Name="CurveLine" FontSize="11" TextWrapping="Wrap"/>
            <SelectableTextBlock x:Name="HoleLine" FontSize="11" TextWrapping="Wrap"/>
            <SelectableTextBlock x:Name="BitmapLine" FontSize="11" TextWrapping="Wrap"/>
            <SelectableTextBlock x:Name="ViaPadSkippedLine" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource CrfWarningBrush}"/>
            <SelectableTextBlock x:Name="LayersRenumberedLine" FontSize="11" TextWrapping="Wrap"/>
            <!-- OASIS only: what an OASIS file cannot hold (round ends, odd widths, label transforms). -->
            <SelectableTextBlock x:Name="OasisLossLine" FontSize="11" TextWrapping="Wrap" IsVisible="False"/>
            <SelectableTextBlock x:Name="ViaFabricationNoteLine"
                       Text="Vias export as geometry only; use Gerber + Excellon for fabrication."
                       FontSize="11" Opacity="0.7"/>
            <!-- Shown only when nothing needed converting, so the list of WHAT did not need it was
                 telling the reader about categories that were never in play. The line says the
                 outcome; the lines above it are where the exceptions appear when there are any. -->
            <SelectableTextBlock x:Name="NoChangesLine" Text="Geometry exports unchanged."
                       FontSize="11" Opacity="0.7" IsVisible="False"/>

            <!-- Text set in code: a warning on circuitRF's own writer, a block on gdstk's (it cannot write a
                 reference to a cell the file does not hold). -->
            <SelectableTextBlock x:Name="UnresolvedHeader"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource CrfWarningBrush}"
                       TextWrapping="Wrap"
                       IsVisible="False"/>
            <ScrollViewer x:Name="UnresolvedScroll" MaxHeight="100" IsVisible="False">
                <ItemsControl x:Name="UnresolvedList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Text="{Binding}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource CrfWarningBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <SelectableTextBlock x:Name="OverflowHeader"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource CrfWarningBrush}"
                       TextWrapping="Wrap"
                       IsVisible="False"/>
            <ScrollViewer x:Name="OverflowScroll" MaxHeight="140" IsVisible="False">
                <ItemsControl x:Name="OverflowList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Text="{Binding}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource CrfWarningBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- OASIS only (brief-oasis-gdstk.md §9b): the writer's four options, remembered per user. -->
            <Border x:Name="OasisOptionsPanel" IsVisible="False" Margin="0,8,0,0" Padding="0,8,0,0"
                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CrfTileBorderBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="OASIS options" FontSize="12" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Compression level" FontSize="11" VerticalAlignment="Center" Width="130"/>
                        <NumericUpDown x:Name="OasisCompression" Minimum="0" Maximum="9" Increment="1" FormatString="0"
                                       Width="110" FontSize="11"
                                       ToolTip.Tip="Deflate level for compressed blocks: 0 stores them uncompressed, 9 compresses most."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Validation" FontSize="11" VerticalAlignment="Center" Width="130"/>
                        <ComboBox x:Name="OasisValidationBox" Width="110" FontSize="11"
                                  ToolTip.Tip="How a reader can check the file's bytes: a CRC-32, a simple 32-bit checksum, or nothing.">
                            <ComboBoxItem Content="None"/>
                            <ComboBoxItem Content="CRC-32"/>
                            <ComboBoxItem Content="Checksum-32"/>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="OasisDetectShapes" FontSize="11"
                              Content="Write rectangles and trapezoids as OASIS shapes"
                              ToolTip.Tip="Smaller files. Off writes every polygon as a general polygon."/>
                    <CheckBox x:Name="OasisStandardProperties" FontSize="11"
                              Content="Write standard properties"
                              ToolTip.Tip="Adds the SEMI standard properties (bounding boxes, top cell, maximum counts) some readers use."/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" FontSize="12" HorizontalContentAlignment="Center" Click="OnCancelClick"/>
            <Button x:Name="ExportButton" Content="Export" Width="80" IsDefault="True" FontSize="12"
                    HorizontalContentAlignment="Center" Click="OnExportClick"/>
        </StackPanel>

    </Grid>
</Window>
