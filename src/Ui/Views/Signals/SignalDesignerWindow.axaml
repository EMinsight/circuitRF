<!-- The MOD_Source Signal Designer. Left pane: the carriers (LTE / NR / CW / pulsed CW / FSK / DBPSK / CSS / imported I/Q)
     as cards, the signal-wide settings and the presets for the common cases, one row per family (cellular, radar,
     IoT and metering). Right pane: the composite spectrum and the CCDF — Data Display
     PlotControls at the golden ratio, exactly as the Match Designer hosts its two — and the numbers a
     designer reads first (IBW, PAPR, ideal ACLR). A second tab, EVM, shows each LTE / NR carrier's
     constellation over its ideal points with the EVM, and a few envelope cycles of
     power around the peak with the average and peak lines. Generation runs in the background through the same
     cache the simulation reads, and reports in the footer and on a live row of the Messages pane.
     Styling is the Match Designer's: `pane` / `card` borders on the theme's chrome brushes and the one
     tile border the application uses, sentence-case headings. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CircuitRF.Ui.Signals"
        xmlns:ddc="using:CircuitRF.Ui.DataDisplay.Controls"
        xmlns:ddv="using:CircuitRF.Ui.DataDisplay.ViewModels"
        xmlns:ddvw="using:CircuitRF.Ui.Views.DataDisplay"
        xmlns:ctl="using:CircuitRF.Ui.Controls"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="CircuitRF.Ui.Views.Signals.SignalDesignerWindow"
        x:DataType="vm:SignalDesignerViewModel"
        Title="{Binding Title}"
        Width="1199" Height="800" MinWidth="1000" MinHeight="680"
        CanResize="True">

    <!-- Delete removes the selected markers, wherever focus sits; a text field takes the key first. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedMarkersCommand}"/>
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="Border.pane">
            <Setter Property="Background"      Value="{DynamicResource SystemChromeMediumLowColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CrfTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="10"/>
            <Setter Property="Margin"          Value="4"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background"      Value="{DynamicResource SystemChromeLowColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CrfTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="Margin"          Value="0,0,0,6"/>
        </Style>
        <Style Selector="TextBlock.panelhdr">
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style Selector="TextBlock.cardhdr">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,2,0,4"/>
        </Style>
        <Style Selector="TextBlock.lbl">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Opacity"           Value="0.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector=":is(TextBlock).note">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Opacity"      Value="0.75"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.card NumericUpDown">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="72"/>
        </Style>
        <Style Selector="Border.card ComboBox">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Border.card TextBox">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Border.card CheckBox">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- The thicker border takes its extra pixel out of the padding (8,6 in Border.card), so selecting a card
             moves nothing: neither its own contents nor the cards below it. -->
        <Style Selector="Border.card.selected">
            <Setter Property="BorderBrush"     Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding"         Value="7,5"/>
        </Style>
        <Style Selector="TextBlock.bignum">
            <Setter Property="FontSize"   Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity"  Value="0.75"/>
        </Style>
        <Style Selector="StackPanel.key TextBlock">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- An entry that does not parse, as every typed field in the application marks one. -->
        <Style Selector="TextBox.error">
            <Setter Property="BorderBrush" Value="{DynamicResource CrfWarningBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="Button.small">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding"  Value="10,4"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" Margin="4">
        <Grid ColumnDefinitions="640,*">
            <!-- ── left: signal definition ─────────────────────────────────────── -->
            <Border Grid.Column="0" Classes="pane">
                <!-- The header stays put above the scrolling cards: inside the ScrollViewer, a focus that scrolled a
                     card into view moved the header too and cut the top off its buttons. -->
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,6,0">
                        <TextBlock Classes="panelhdr" Text="Signal" VerticalAlignment="Center"/>
                        <!-- Icon-only, as the schematic toolbar's buttons are: the name is in the tooltip. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,2,0,8">
                            <Button Padding="6,3" Command="{Binding ExportSignalCommand}"
                                    ToolTip.Tip="Export signal: save it as a two-column I Q text file (sample-rate header), the format a FILE carrier imports">
                                <mi:MaterialIcon Kind="ExportVariant" Width="16" Height="16"/>
                            </Button>
                            <Button Name="HelpButton" Padding="6,3" Click="OnHelpClick"
                                    ToolTip.Tip="Help — the Signal Designer page of the circuitRF reference">
                                <mi:MaterialIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">

                        <Border Classes="card">
                            <StackPanel>
                                <TextBlock Classes="cardhdr" Text="Source"/>
                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Classes="lbl" Text="{Binding FcUnit, StringFormat='Centre Fc ({0})'}" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding FcText}"
                                             ToolTip.Tip="A number in the unit shown, or an expression / variable (e.g. RFfreq) — written back exactly as typed"/>
                                    <TextBlock Grid.Column="2" Classes="lbl" Text="{Binding PowerLabel}" Margin="12,0,6,0"/>
                                    <TextBox Grid.Column="3" Text="{Binding PavgText}"
                                             ToolTip.Tip="A number in dBm, or an expression / variable (e.g. Pin, so a power sweep still sweeps it)"/>
                                    <TextBlock Grid.Row="1" Classes="lbl" Text="Record (ms)" Margin="0,6,6,0"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Value="{Binding RecordMs}" Increment="0.5" Minimum="0.5" FormatString="0.#"
                                                   IsEnabled="{Binding CanEditRecord}"
                                                   ToolTip.Tip="Periodic record length, whole 0.5 ms slots (a pulse's record is its PRI). ACPR settles within ~0.1 dB from 0.5 ms; longer records tighten the statistics."/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="lbl" Text="Sample rate" Margin="12,6,6,0"/>
                                    <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SampleRate}"
                                              ToolTip.Tip="Sample rate of the preview and of Export signal (a custom file is resampled to it; File rate keeps the file's own). Auto = the recommended rate for this signal. Not written to the source; the simulation picks its own time step."/>
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Classes="note" Margin="0,6,0,0" Text="{Binding SampleRateInfo}"/>
                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Classes="note" Margin="0,4,0,0" Text="{Binding PulsePowerInfo}"
                                               IsVisible="{Binding IsPulse}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Margin="0,4,0,6" IsEnabled="{Binding IsNotCustom}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="cardhdr" Text="Presets"/>
                                <!-- One row per family, its name on the left. A family of several standards is one button with
                                     a menu (one item per mode), so a row does not grow by a button per mode. -->
                                <Grid ColumnDefinitions="64,*" RowDefinitions="Auto,Auto,Auto" Tag="preset-rows">
                                    <TextBlock Classes="lbl" Text="Cellular" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                    <WrapPanel Grid.Column="1">
                                        <Button Classes="small" Margin="0,0,6,4" Content="LTE 20 MHz" Command="{Binding PresetLte20Command}"/>
                                        <Button Classes="small" Margin="0,0,6,4" Content="NR 20 MHz (30 kHz)" Command="{Binding PresetNr20Command}"/>
                                        <Button Classes="small" Margin="0,0,6,4" Content="NR 100 MHz (30 kHz)" Command="{Binding PresetNr100Command}"/>
                                        <Button Classes="small" Margin="0,0,6,4" Content="4 x LTE 20 contiguous" Command="{Binding PresetFourCarrierLteCommand}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                            <Button Classes="small" Content="2C NR 20 at spacing" Command="{Binding PresetTwoCarrierCommand}"
                                                    ToolTip.Tip="Two NR 20 MHz carriers at the centre-to-centre spacing in the field beside it"/>
                                            <NumericUpDown Value="{Binding PresetSpacingMHz}" Increment="20" Minimum="20" FormatString="0.#" MinWidth="90"
                                                           ToolTip.Tip="Centre-to-centre spacing of the 2C preset's two carriers"/>
                                            <TextBlock Classes="lbl" Text="MHz apart"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Grid.Row="1" Classes="lbl" Text="Radar" Margin="0,2,0,4"/>
                                    <Button Grid.Row="1" Grid.Column="1" Classes="small" Margin="0,2,0,4" HorizontalAlignment="Left" Content="Pulsed CW"
                                            Command="{Binding PresetPulseCommand}"
                                            ToolTip.Tip="One pulsed-CW carrier, for a pulsed-radar amplifier: set its PRI, width, edges and delay on the card"/>
                                    <TextBlock Grid.Row="2" Classes="lbl" Text="IoT" Margin="0,2,0,0"/>
                                    <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,2,0,0">
                                        <!-- Each sets one carrier and moves Centre Fc to the mode's channel (unless Fc is an expression). -->
                                        <Button Classes="small" Margin="0,0,6,0" Tag="wmbus-presets"
                                                ToolTip.Tip="Wireless M-Bus (EN 13757-4): one FSK carrier on PN9 data at a mode's chip rate and deviation. Sets Centre Fc unless it is an expression.">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="Wireless M-Bus"/>
                                                <mi:MaterialIcon Kind="MenuDown" Width="14" Height="14"/>
                                            </StackPanel>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                    <MenuItem Header="C1 / C2  meter → other   868.95 MHz, 100 kchip/s, ±45 kHz, FSK" Command="{Binding PresetWmbusC1Command}"/>
                                                    <MenuItem Header="C2  other → meter   869.525 MHz, 50 kchip/s, ±25 kHz, GFSK BT 0.5" Command="{Binding PresetWmbusC2Command}"/>
                                                    <MenuItem Header="T1 / T2  meter → other   868.95 MHz, 100 kchip/s, ±50 kHz, FSK" Command="{Binding PresetWmbusT1Command}"/>
                                                    <MenuItem Header="T2  other → meter   868.3 MHz, 32.768 kchip/s, ±50 kHz, FSK" Command="{Binding PresetWmbusT2Command}"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button Classes="small" Margin="0,0,6,0" Tag="ble-presets"
                                                ToolTip.Tip="Bluetooth Low Energy: one GFSK carrier on PN9 data (h = 0.5, BT 0.5) at 2.44 GHz, mid-band. LE Coded (125 and 500 kb/s) uses the LE 1M air interface: its coding is in the bits. Sets Centre Fc unless it is an expression.">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="Bluetooth LE"/>
                                                <mi:MaterialIcon Kind="MenuDown" Width="14" Height="14"/>
                                            </StackPanel>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                    <MenuItem Header="LE 1M / LE Coded   2.44 GHz, 1 Msym/s, ±250 kHz, GFSK BT 0.5" Command="{Binding PresetBle1MCommand}"/>
                                                    <MenuItem Header="LE 2M   2.44 GHz, 2 Msym/s, ±500 kHz, GFSK BT 0.5" Command="{Binding PresetBle2MCommand}"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button Classes="small" Margin="0,0,6,0" Tag="lorawan-presets"
                                                ToolTip.Tip="LoRaWAN, EU868: one LoRa (chirp spread spectrum) packet at 868.1 MHz, 125 kHz. Sets Centre Fc unless it is an expression.">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="LoRaWAN"/>
                                                <mi:MaterialIcon Kind="MenuDown" Width="14" Height="14"/>
                                            </StackPanel>
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                    <MenuItem Header="SF7    868.1 MHz, 125 kHz, CSS, 45 ms packet" Command="{Binding PresetLoRaWanSf7Command}"/>
                                                    <MenuItem Header="SF12   868.1 MHz, 125 kHz, CSS, 1.45 s packet" Command="{Binding PresetLoRaWanSf12Command}"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button Classes="small" Content="Sigfox" Command="{Binding PresetSigfoxCommand}"
                                                ToolTip.Tip="Sigfox RC1 uplink: 100 b/s DBPSK on PN9 at 868.13 MHz. Sets Centre Fc unless it is an expression."/>
                                    </WrapPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Custom I/Q: an I/Q file as the whole signal. Always shown, so Load custom is always within
                             reach; empty while the carriers below make the signal. With a file loaded, the presets,
                             carriers, record and shaping are the file's and are disabled, and the X gives them back. -->
                        <Border Classes="card" Margin="0,0,0,6" Tag="custom-card">
                            <StackPanel Spacing="6" DataContext="{Binding CustomCarrier}" x:DataType="vm:CarrierRowViewModel">
                                <TextBlock Classes="cardhdr" Text="Custom I/Q"/>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Button Padding="6,3" Margin="0,0,6,0" VerticalAlignment="Top"
                                            Command="{Binding $parent[Window].((vm:SignalDesignerViewModel)DataContext).LoadCustomCommand}"
                                            ToolTip.Tip="Load custom: use an I/Q file as the whole signal (two columns I Q, optionally a # sample_rate_hz header: the format Export signal writes)">
                                        <mi:MaterialIcon Kind="FileImport" Width="16" Height="16"/>
                                    </Button>
                                    <!-- Wrapped, not scrolled: a long path keeps its file name - the part that matters - in view. -->
                                    <TextBox Grid.Column="1" Text="{Binding FilePath}" IsReadOnly="True" TextWrapping="Wrap"
                                             PlaceholderText="No file: the carriers below make the signal"
                                             ToolTip.Tip="Stored in the schematic relative to the workspace when it can be, as a Touchstone file is"/>
                                    <Button Grid.Column="2" Padding="6,3" Margin="4,0,0,0" VerticalAlignment="Top"
                                            Command="{Binding $parent[Window].((vm:SignalDesignerViewModel)DataContext).RemoveCustomCommand}"
                                            IsEnabled="{Binding $parent[Window].((vm:SignalDesignerViewModel)DataContext).IsCustom}"
                                            ToolTip.Tip="Remove custom file: back to the carriers this signal had before, with the presets and carriers enabled again">
                                        <mi:MaterialIcon Kind="Close" Width="14" Height="14"/>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding $parent[Window].((vm:SignalDesignerViewModel)DataContext).IsCustom}">
                                    <TextBlock Classes="lbl" Text="File sample rate (MHz)" Margin="0,0,6,0" VerticalAlignment="Top" Padding="0,6,0,0"/>
                                    <!-- Validated as typed: an invalid entry is marked on the field and never reaches the signal. -->
                                    <TextBox Grid.Column="1" Text="{Binding SampleRateText}" Width="160" HorizontalAlignment="Left"
                                             PlaceholderText="e.g. 122.88"
                                             Classes.error="{Binding HasSampleRateError}" ToolTip.Tip="{Binding SampleRateTip}"/>
                                </Grid>
                                <TextBlock Classes="note" Text="{Binding $parent[Window].((vm:SignalDesignerViewModel)DataContext).CustomInfo}"
                                           IsVisible="{Binding $parent[Window].((vm:SignalDesignerViewModel)DataContext).IsCustom}"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Classes="cardhdr" Text="Waveform"/>
                                <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto">
                                    <CheckBox Content="Clip to PAPR (dB)" IsChecked="{Binding ClipEnabled}" IsEnabled="{Binding CanClip}"
                                              ToolTip.Tip="Off = unclipped (natural OFDM PAPR, ~11-12 dB; a custom file as it is). On = iterative clip-and-filter to the target."/>
                                    <NumericUpDown Grid.Column="1" Margin="6,0" Value="{Binding ClipPaprDb}" Increment="0.5" FormatString="0.#">
                                        <NumericUpDown.IsEnabled>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="ClipEnabled"/>
                                                <Binding Path="CanClip"/>
                                            </MultiBinding>
                                        </NumericUpDown.IsEnabled>
                                    </NumericUpDown>
                                    <CheckBox Grid.Row="1" Margin="0,4,0,0" Content="Spectral shaping floor (dBc)" IsChecked="{Binding ShapingEnabled}"
                                              IsEnabled="{Binding CanShape}"
                                              ToolTip.Tip="A per-bin ceiling outside the occupied band, so the source's own ACLR sits far below the amplifier's"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Margin="6,4,6,0" Value="{Binding ShapingFloorDbc}" Increment="5" FormatString="0">
                                        <NumericUpDown.IsEnabled>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="ShapingEnabled"/>
                                                <Binding Path="CanShape"/>
                                            </MultiBinding>
                                        </NumericUpDown.IsEnabled>
                                    </NumericUpDown>
                                </Grid>
                                <TextBlock Classes="note" Margin="0,6,0,0" IsVisible="{Binding IsAttached}"
                                           Text="Every edit previews by itself. The signal is generated in the background and cached; a simulation of this source reuses it."/>
                                <TextBlock Classes="note" Margin="0,6,0,0" IsVisible="{Binding !IsAttached}"
                                           Text="Every edit previews by itself. Export signal saves it as an I/Q file."/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Classes="cardhdr" Text="Carriers" VerticalAlignment="Center"/>
                            <Button Padding="6,3" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding AddCarrierCommand}"
                                    IsEnabled="{Binding CanAddCarrier}"
                                    ToolTip.Tip="Add carrier: a new one next to the last">
                                <mi:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Carriers}" IsEnabled="{Binding IsNotCustom}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CarrierRowViewModel">
                                    <Border Classes="card" Classes.selected="{Binding IsSelected}" Tag="carrier-card" Background="Transparent"
                                            ToolTip.Tip="Click a carrier to show its EVM on the EVM tab">
                                        <Grid ColumnDefinitions="Auto,90,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                            <Border Background="{DynamicResource SystemListLowColor}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Index, StringFormat='C{0}'}"/>
                                            </Border>
                                            <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:CarrierRowViewModel.Standards}" SelectedItem="{Binding Standard}" HorizontalAlignment="Stretch"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0" IsVisible="{Binding IsOfdm}">
                                                <TextBlock Classes="lbl" Text="BW (MHz)"/>
                                                <ComboBox ItemsSource="{Binding BandwidthOptions}" SelectedItem="{Binding BandwidthMHz}" MinWidth="70"/>
                                                <TextBlock Classes="lbl" Text="SCS (kHz)" IsVisible="{Binding IsNr}"/>
                                                <ComboBox ItemsSource="{x:Static vm:CarrierRowViewModel.ScsOptions}" SelectedItem="{Binding ScsKHz}" IsVisible="{Binding IsNr}" MinWidth="60"/>
                                            </StackPanel>
                                            <Button Grid.Column="3" Classes="small" Padding="4,2"
                                                    Command="{Binding $parent[Window].((vm:SignalDesignerViewModel)DataContext).RemoveCarrierCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Remove this carrier"
                                                    IsEnabled="{Binding $parent[Window].((vm:SignalDesignerViewModel)DataContext).HasSeveralCarriers}">
                                                <mi:MaterialIcon Kind="Close" Width="14" Height="14"/>
                                            </Button>
                                            <!-- A carrier with no bandwidth picker (CW, PCW, FSK, DBPSK, CSS, FILE) has the row's middle free: Offset and
                                                 Power sit there, a row higher, so a pulse or FSK card fits the window without scrolling. -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0" IsVisible="{Binding !IsOfdm}">
                                                <TextBlock Classes="lbl" Text="Offset (MHz)"/>
                                                <NumericUpDown Value="{Binding OffsetMHz}" Increment="5" FormatString="0.###" MinWidth="90"
                                                               ToolTip.Tip="Carrier centre relative to Fc. Carriers more than 3 channel bandwidths apart get their own envelope fundamental in the simulation."/>
                                                <TextBlock Classes="lbl" Text="Power (dB)"/>
                                                <NumericUpDown Value="{Binding PowerDb}" Increment="1" FormatString="0.##" MinWidth="70"
                                                               IsEnabled="{Binding $parent[Window].((vm:SignalDesignerViewModel)DataContext).HasSeveralCarriers}"
                                                               ToolTip.Tip="Relative to the other carriers; Pavg sets the total. With one carrier there is nothing to be relative to."/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" IsVisible="{Binding IsOfdm}">
                                                <TextBlock Classes="lbl" Text="Offset (MHz)"/>
                                                <NumericUpDown Value="{Binding OffsetMHz}" Increment="5" FormatString="0.###" MinWidth="90"
                                                               ToolTip.Tip="Carrier centre relative to Fc. Carriers more than 3 channel bandwidths apart get their own envelope fundamental in the simulation."/>
                                                <TextBlock Classes="lbl" Text="Power (dB)"/>
                                                <NumericUpDown Value="{Binding PowerDb}" Increment="1" FormatString="0.##" MinWidth="70"
                                                               IsEnabled="{Binding $parent[Window].((vm:SignalDesignerViewModel)DataContext).HasSeveralCarriers}"
                                                               ToolTip.Tip="Relative to the other carriers; Pavg sets the total. With one carrier there is nothing to be relative to."/>
                                                <!-- only an OFDM carrier draws random data -->
                                                <TextBlock Classes="lbl" Text="Seed" IsVisible="{Binding IsOfdm}"/>
                                                <NumericUpDown Value="{Binding Seed}" Increment="1" Minimum="0" FormatString="0" MinWidth="60" IsVisible="{Binding IsOfdm}"/>
                                                <ComboBox ItemsSource="{x:Static vm:CarrierRowViewModel.Modulations}" SelectedItem="{Binding Modulation}" MinWidth="96"
                                                          IsVisible="{Binding IsOfdm}" ToolTip.Tip="Subcarrier modulation"/>
                                            </StackPanel>
                                            <Grid Grid.Row="2" Grid.ColumnSpan="4" ColumnDefinitions="*,Auto" Margin="0,6,0,0" IsVisible="{Binding IsFile}">
                                                <TextBox Text="{Binding FilePath}" TextWrapping="Wrap" PlaceholderText="I/Q text file (# sample_rate_hz header, I Q columns)"/>
                                                <Button Grid.Column="1" Classes="small" Margin="4,0,0,0" Content="Browse…"
                                                        Command="{Binding $parent[Window].((vm:SignalDesignerViewModel)DataContext).BrowseFileCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                            <!-- Pulsed CW: the pulse's timing, each typed with its unit (a bare number is µs) and outlined
                                                 when it does not parse or when the pulse it makes cannot be generated. -->
                                            <Grid Grid.Row="3" Grid.ColumnSpan="4" ColumnDefinitions="Auto,110,Auto,Auto,110,Auto" RowDefinitions="Auto,Auto,Auto"
                                                  Margin="0,6,0,0" IsVisible="{Binding IsPcw}" Tag="pulse-fields">
                                                <TextBlock Classes="lbl" Text="PRI (µs)" Margin="0,0,6,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding PriText}" Classes.error="{Binding HasPriError}"
                                                         ToolTip.Tip="{Binding PriError, TargetNullValue='Pulse repetition interval: the record is one PRI, which repeats, so Stop in the Envelope analysis sets how many pulses are simulated'}"/>
                                                <TextBlock Grid.Column="2" Classes="lbl" Margin="6,0,12,0" Text="{Binding PrfText}"/>
                                                <TextBlock Grid.Column="3" Classes="lbl" Text="Width (µs)" Margin="0,0,6,0"/>
                                                <TextBox Grid.Column="4" Text="{Binding WidthText}" Classes.error="{Binding HasWidthError}"
                                                         ToolTip.Tip="{Binding WidthError, TargetNullValue='Pulse width, from the 50 % point of the rising edge to the 50 % point of the falling edge'}"/>
                                                <TextBlock Grid.Column="5" Classes="lbl" Margin="6,0,0,0" Text="{Binding DutyText}"/>
                                                <TextBlock Grid.Row="1" Classes="lbl" Text="Rise (µs)" Margin="0,6,6,0"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding RiseText}" Classes.error="{Binding HasRiseError}"
                                                         ToolTip.Tip="{Binding RiseError, TargetNullValue='10-90 % time of the raised-cosine rising edge; the faster edge sets the bandwidth'}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="3" Classes="lbl" Text="Fall (µs)" Margin="0,6,6,0"/>
                                                <TextBox Grid.Row="1" Grid.Column="4" Margin="0,6,0,0" Text="{Binding FallText}" Classes.error="{Binding HasFallError}"
                                                         ToolTip.Tip="{Binding FallError, TargetNullValue='10-90 % time of the raised-cosine falling edge'}"/>
                                                <TextBlock Grid.Row="2" Classes="lbl" Text="Delay (µs)" Margin="0,6,6,0"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Text="{Binding DelayText}" Classes.error="{Binding HasDelayError}"
                                                         ToolTip.Tip="{Binding DelayError, TargetNullValue='Off-time before the rising edge, greater than 0 so the run starts at the quiescent point. Empty centres the pulse in the PRI.'}"/>
                                                <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="4" Classes="lbl" Margin="6,6,0,0" Text="{Binding DelayInfo}"/>
                                            </Grid>
                                            <!-- FSK: rate, deviation, filter and data. A Gaussian filter makes it GFSK (GMSK at h = 0.5);
                                                 the data is one period of a PN sequence or a fixed pattern, and that period is the record. -->
                                            <Grid Grid.Row="4" Grid.ColumnSpan="4" ColumnDefinitions="Auto,140,Auto,110" RowDefinitions="Auto,Auto,Auto,Auto"
                                                  Margin="0,6,0,0" IsVisible="{Binding IsFsk}" Tag="fsk-fields">
                                                <TextBlock Classes="lbl" Text="Bit rate (kb/s)" Margin="0,0,6,0"/>
                                                <NumericUpDown Grid.Column="1" Value="{Binding BitRateKbps}" Increment="10" Minimum="0.001" FormatString="0.######"
                                                               ToolTip.Tip="Bit (chip) rate. One bit lasts 1 / Rb at +Dev (a 1) or -Dev (a 0)."/>
                                                <TextBlock Grid.Column="2" Classes="lbl" Text="Deviation (kHz)" Margin="12,0,6,0"/>
                                                <NumericUpDown Grid.Column="3" Value="{Binding DeviationKHz}" Increment="5" Minimum="0.001" FormatString="0.######"
                                                               ToolTip.Tip="Peak frequency deviation: a 1 sits at Fc + Dev, a 0 at Fc - Dev"/>
                                                <TextBlock Grid.Row="1" Classes="lbl" Text="Filter" Margin="0,6,6,0"/>
                                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                                          ItemsSource="{x:Static vm:CarrierRowViewModel.FilterOptions}" SelectedItem="{Binding Filter}"
                                                          ToolTip.Tip="None: rectangular frequency steps (CPFSK). Gaussian: GFSK, or GMSK when h = 0.5."/>
                                                <TextBlock Grid.Row="1" Grid.Column="2" Classes="lbl" Text="BT" Margin="12,6,6,0" IsVisible="{Binding IsGaussian}"/>
                                                <NumericUpDown Grid.Row="1" Grid.Column="3" Margin="0,6,0,0" Value="{Binding Bt}" Increment="0.1" Minimum="0.05" FormatString="0.###"
                                                               IsVisible="{Binding IsGaussian}"
                                                               ToolTip.Tip="Bandwidth-time product of the Gaussian filter: 0.5 for wireless M-Bus C mode, 0.3 for GSM's GMSK"/>
                                                <TextBlock Grid.Row="2" Classes="lbl" Text="Data" Margin="0,6,6,0"/>
                                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                                          ItemsSource="{x:Static vm:CarrierRowViewModel.DataOptions}" SelectedItem="{Binding DataChoice}"
                                                          ToolTip.Tip="PN9 (511 bits) or PN15 (32,767 bits), or a fixed pattern. The record is one period of it."/>
                                                <TextBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="12,6,0,0" Text="{Binding BitsText}"
                                                         IsVisible="{Binding IsFixedBits}" Classes.error="{Binding HasBitsError}"
                                                         ToolTip.Tip="{Binding BitsError, TargetNullValue='The bits, first to last, as 0s and 1s; the pattern repeats'}"/>
                                                <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Classes="note" Margin="0,6,0,0" Text="{Binding FskInfoText}"/>
                                                <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Classes="note" Margin="0,6,0,0" Text="{Binding FskRefusal}"
                                                           Foreground="{DynamicResource CrfWarningBrush}" IsVisible="{Binding FskRefusal, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            </Grid>
                                            <!-- DBPSK: the bit rate and the same Data as FSK; a 0 reverses the phase. -->
                                            <Grid Grid.Row="4" Grid.ColumnSpan="4" ColumnDefinitions="Auto,140,Auto,110" RowDefinitions="Auto,Auto,Auto"
                                                  Margin="0,6,0,0" IsVisible="{Binding IsDbpsk}" Tag="dbpsk-fields">
                                                <TextBlock Classes="lbl" Text="Bit rate (b/s)" Margin="0,0,6,0"/>
                                                <NumericUpDown Grid.Column="1" Value="{Binding DbpskRateBps}" Increment="100" Minimum="1" FormatString="0.######"
                                                               ToolTip.Tip="Bit rate: 100 b/s for a UNB uplink in the 868 MHz band, 600 b/s where the rules allow it"/>
                                                <TextBlock Grid.Row="1" Classes="lbl" Text="Data" Margin="0,6,6,0"/>
                                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                                          ItemsSource="{x:Static vm:CarrierRowViewModel.DataOptions}" SelectedItem="{Binding DataChoice}"
                                                          ToolTip.Tip="PN9 (511 bits) or PN15 (32,767 bits), or a fixed pattern. A 0 reverses the phase, a 1 keeps it."/>
                                                <TextBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="12,6,0,0" Text="{Binding BitsText}"
                                                         IsVisible="{Binding IsFixedBits}" Classes.error="{Binding HasBitsError}"
                                                         ToolTip.Tip="{Binding BitsError, TargetNullValue='The bits, first to last, as 0s and 1s; the pattern repeats'}"/>
                                                <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Classes="note" Margin="0,6,0,0" Text="{Binding DbpskInfoText}"/>
                                                <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Classes="note" Margin="0,6,0,0" Text="{Binding DbpskRefusal}"
                                                           Foreground="{DynamicResource CrfWarningBrush}" IsVisible="{Binding DbpskRefusal, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            </Grid>
                                            <!-- CSS: spreading factor and chirp bandwidth, both picked; the record is one packet. -->
                                            <Grid Grid.Row="4" Grid.ColumnSpan="4" ColumnDefinitions="Auto,140,Auto,110" RowDefinitions="Auto,Auto"
                                                  Margin="0,6,0,0" IsVisible="{Binding IsCss}" Tag="css-fields">
                                                <TextBlock Classes="lbl" Text="SF" Margin="0,0,6,0"/>
                                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                          ItemsSource="{x:Static vm:CarrierRowViewModel.SfOptions}" SelectedItem="{Binding Sf}"
                                                          ToolTip.Tip="Spreading factor: 2^SF chips per symbol. Each step up doubles the symbol and the packet, for longer reach."/>
                                                <TextBlock Grid.Column="2" Classes="lbl" Text="BW (kHz)" Margin="12,0,6,0"/>
                                                <ComboBox Grid.Column="3" HorizontalAlignment="Stretch"
                                                          ItemsSource="{x:Static vm:CarrierRowViewModel.CssBandwidthOptions}" SelectedItem="{Binding CssBandwidthKHz}"
                                                          ToolTip.Tip="The chirp's sweep: 125 kHz on the 868 MHz channels, 250 or 500 kHz where allowed"/>
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Classes="note" Margin="0,6,0,0" Text="{Binding CssInfoText}"/>
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Classes="note" Margin="0,6,0,0" Text="{Binding CssRefusal}"
                                                           Foreground="{DynamicResource CrfWarningBrush}" IsVisible="{Binding CssRefusal, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── right: preview ───────────────────────────────────────────────── -->
            <Border Grid.Column="1" Classes="pane">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Classes="panelhdr" Text="Preview"/>
                    <TabControl Grid.Row="1" SelectedIndex="{Binding PreviewTab}" Padding="0,4,0,0">
                        <TabItem Header="Spectrum and CCDF" FontSize="13">
                            <Grid RowDefinitions="*,*,Auto,Auto">
                                <!-- Golden ratio, the Match Designer's own layout: the panel LAYS the plot out at
                                     1.618:1 so the axis text and strokes keep the Data Display's own sizes. -->
                                <ctl:AspectRatioPanel Grid.Row="0" Margin="0,2">
                                    <ddc:PlotControl Name="PsdPlotControl" Plot="{Binding PsdPlot}" Library="{Binding PlotHost.Library}"
                                                     CanDeletePlot="False" CanEditPlotProperties="False"/>
                                </ctl:AspectRatioPanel>
                                <ctl:AspectRatioPanel Grid.Row="1" Margin="0,2">
                                    <ddc:PlotControl Name="CcdfPlotControl" Plot="{Binding CcdfPlot}" Library="{Binding PlotHost.Library}"
                                                     CanDeletePlot="False" CanEditPlotProperties="False"/>
                                </ctl:AspectRatioPanel>
                                <!-- A pulse's CCDF over its on-time, as an analyser gates a burst; a Designer setting, never written. -->
                                <CheckBox Grid.Row="2" Margin="2,2,0,0" FontSize="12" IsVisible="{Binding IsPulse}" IsChecked="{Binding GateCcdf}"
                                          Content="CCDF over the pulse on-time only (gated)"
                                          ToolTip.Tip="On: the CCDF and PAPR are measured from the rising edge's 50 % point to the falling edge's, against the pulse's own average, as a signal analyser gates a burst. Off: over the whole PRI, where the duty cycle sets the step."/>
                                <Border Grid.Row="3" Classes="card" Margin="0,4,0,0">
                                    <SelectableTextBlock Text="{Binding Stats}" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="11" TextWrapping="NoWrap"/>
                                </Border>
                                <!-- Marker info boxes for this tab's plots: the Data Display's own overlay, click-through
                                     (no Background) except on a box. One layer per tab, so a hidden tab's boxes hide too. -->
                                <ItemsControl Name="SpectrumInfoBoxLayer" Grid.RowSpan="4" Background="{x:Null}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Background="{x:Null}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerTheme>
                                        <ControlTheme TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{ReflectionBinding ViewLeft}"/>
                                            <Setter Property="Canvas.Top"  Value="{ReflectionBinding ViewTop}"/>
                                        </ControlTheme>
                                    </ItemsControl.ItemContainerTheme>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ddv:MarkerInfoBoxViewModel">
                                            <ddvw:MarkerInfoBoxView/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </TabItem>

                        <!-- EVM: the numbers first (EVM against its limit, peak-to-average), then the
                             constellation of the chosen carrier over its ideal points, then a few
                             envelope cycles of power around the peak with the average and peak lines. -->
                        <TabItem Header="{Binding SecondTabHeader}" FontSize="13">
                            <Grid>
                            <!-- a pulse, FSK, DBPSK or CSS carrier carries no QAM symbols, so in the EVM's place: the pulse over one
                                 PRI, the instantaneous frequency (FSK, CSS) or the in-phase waveform (DBPSK), with its own marker layer -->
                            <Grid IsVisible="{Binding HasTimePlot}">
                                <ctl:AspectRatioPanel VerticalAlignment="Top" Margin="0,2">
                                    <ddc:PlotControl Name="TimePlotControl" Plot="{Binding TimePlot}" Library="{Binding PlotHost.Library}"
                                                     CanDeletePlot="False" CanEditPlotProperties="False"/>
                                </ctl:AspectRatioPanel>
                                <ItemsControl Name="TimeInfoBoxLayer" Background="{x:Null}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Background="{x:Null}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerTheme>
                                        <ControlTheme TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{ReflectionBinding ViewLeft}"/>
                                            <Setter Property="Canvas.Top"  Value="{ReflectionBinding ViewTop}"/>
                                        </ControlTheme>
                                    </ItemsControl.ItemContainerTheme>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ddv:MarkerInfoBoxViewModel">
                                            <ddvw:MarkerInfoBoxView/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" IsVisible="{Binding HasEvmTab}">
                                <Grid ColumnDefinitions="*,*">
                                    <!-- the two headline numbers, laid out alike: caption, number, one detail line -->
                                    <Border Classes="card" Margin="0,0,6,6">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="caption" Text="EVM (rms)"/>
                                            <TextBlock Classes="bignum" Text="{Binding SelectedEvm.RmsText, FallbackValue='-'}"/>
                                            <TextBlock Classes="caption" IsVisible="{Binding HasEvm}">
                                                <Run Text="{Binding SelectedEvm.DbText, FallbackValue=''}"/>
                                                <Run Text="   ·   peak"/>
                                                <Run Text="{Binding SelectedEvm.PeakText, FallbackValue=''}"/>
                                            </TextBlock>
                                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding EvmNote}" IsVisible="{Binding !HasEvm}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="card" Margin="0,0,0,6">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="caption" Text="Peak - average"/>
                                            <TextBlock Classes="bignum" Text="{Binding PaprText}"/>
                                            <TextBlock Classes="caption" Text="gap between the two lines below"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- which signal the EVM was measured on: read-only, it follows the carrier selected
                                     on the left; Calculate re-generates from the left panel and measures again -->
                                <Border Grid.Row="1" Classes="card" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Classes="caption" Text="Measured signal (select a carrier on the left)"/>
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding EvmSignalText}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="small" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding CalculateEvmCommand}" ToolTip.Tip="Generate the signal on the left and measure its EVM">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <mi:MaterialIcon Kind="Calculator" Width="14" Height="14"/>
                                                <TextBlock Text="Calculate"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- the constellation, square and centred, with its key -->
                                <StackPanel Grid.Row="2" Width="250" HorizontalAlignment="Center" Margin="0,2">
                                    <ctl:AspectRatioPanel Ratio="1">
                                        <ddc:PlotControl Name="ConstellationPlotControl" Plot="{Binding ConstellationPlot}" Library="{Binding PlotHost.Library}"
                                                         CanDeletePlot="False" CanEditPlotProperties="False"/>
                                    </ctl:AspectRatioPanel>
                                    <StackPanel Classes="key" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#0000FF"/>
                                        <TextBlock Text="received"/>
                                        <TextBlock Text="×" Foreground="#FF0000" FontWeight="Bold" FontSize="13" Margin="10,0,0,0"/>
                                        <TextBlock Text="ideal"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Classes="key" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Rectangle Width="18" Height="2" Fill="#0000FF"/>
                                    <TextBlock Text="power"/>
                                    <Rectangle Width="18" Height="3" Fill="#008000" Margin="10,0,0,0"/>
                                    <TextBlock Text="average"/>
                                    <Line StartPoint="0,0" EndPoint="18,0" Stroke="#FF0000" StrokeThickness="2.5" StrokeDashArray="2,1.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="peak"/>
                                    <TextBlock Text="Window (µs)" Margin="16,0,0,0" Opacity="0.8"/>
                                    <NumericUpDown Value="{Binding EnvelopeWindowUs}" Minimum="0.05" Maximum="500" Increment="0.5"
                                                   FormatString="0.##" FontSize="11" MinWidth="90" Height="24"
                                                   ToolTip.Tip="Length of the stretch shown, centred on the record's peak. Changing it only redraws this plot."/>
                                </StackPanel>
                                <!-- fills the height that is left, centred, so the time axis is never below the window edge -->
                                <ctl:AspectRatioPanel Grid.Row="4" Margin="0,2" MinHeight="200">
                                    <Grid>
                                        <ddc:PlotControl Name="EnvelopePlotControl" Plot="{Binding EnvelopePlot}" Library="{Binding PlotHost.Library}"
                                                         CanDeletePlot="False" CanEditPlotProperties="False"/>
                                        <!-- the peak - average value, beside the black arrow; placed from the plot's own transform -->
                                        <Canvas IsHitTestVisible="False">
                                            <Border Name="GapLabel" Background="#D0FFFFFF" CornerRadius="3" Padding="3,0" IsVisible="False">
                                                <TextBlock Name="GapLabelText" FontSize="12" FontWeight="Bold" Foreground="Black"/>
                                            </Border>
                                        </Canvas>
                                    </Grid>
                                </ctl:AspectRatioPanel>
                                <!-- Marker info boxes for this tab's plots: the Data Display's own overlay, click-through
                                     (no Background) except on a box. One layer per tab, so a hidden tab's boxes hide too. -->
                                <ItemsControl Name="EvmInfoBoxLayer" Grid.RowSpan="5" Background="{x:Null}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Background="{x:Null}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerTheme>
                                        <ControlTheme TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{ReflectionBinding ViewLeft}"/>
                                            <Setter Property="Canvas.Top"  Value="{ReflectionBinding ViewTop}"/>
                                        </ControlTheme>
                                    </ItemsControl.ItemContainerTheme>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ddv:MarkerInfoBoxViewModel">
                                            <ddvw:MarkerInfoBoxView/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- ── footer: status + the Match Designer's progress row, then the actions ─────────────── -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="6,2,6,4">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock FontSize="12" Opacity="0.85" Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <ProgressBar Width="120" Height="4" Minimum="0" Maximum="1" VerticalAlignment="Center"
                             Value="{Binding Progress}" IsVisible="{Binding IsBusy}"/>
                <Button Content="Cancel" FontSize="11" Padding="6,1" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="small" Margin="6,0,0,0" Command="{Binding PreviewCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <mi:MaterialIcon Kind="Refresh" Width="14" Height="14"/>
                    <TextBlock Text="Preview"/>
                </StackPanel>
            </Button>
            <!-- Apply needs a MOD_Source: from Tools ▸ Signal Designer there is none, and Export signal is the way out. -->
            <Button Grid.Column="2" Classes="small" Margin="6,0,0,0" Command="{Binding ApplyCommand}" IsVisible="{Binding IsAttached}"
                    ToolTip.Tip="Write the signal to the MOD_Source (one undo step)">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <mi:MaterialIcon Kind="Check" Width="14" Height="14"/>
                    <TextBlock Text="Apply"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Classes="small" Margin="6,0,0,0" Content="Apply &amp; Close" Click="OnApplyClose" IsVisible="{Binding IsAttached}"/>
            <Button Grid.Column="4" Classes="small" Margin="6,0,0,0" Content="Close" Click="OnClose"/>
        </Grid>
    </Grid>
</Window>
