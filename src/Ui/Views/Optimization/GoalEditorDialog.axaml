<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:opt="using:CircuitRF.Ui.Optimization"
        xmlns:dopt="using:CircuitRF.Design.Optimization"
        xmlns:optv="using:CircuitRF.Ui.Views.Optimization"
        x:Class="CircuitRF.Ui.Views.Optimization.GoalEditorDialog"
        x:DataType="opt:GoalEditorViewModel"
        Title="{Binding Title}"
        Width="720" Height="520" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnKeyDown">

    <!-- brief-tuneopt-10 R-to10-4. Left: the template catalog, grouped. Right: the goal's fields and,
         when results exist, a preview of the expression over the range with the limit drawn. -->

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <!-- The five goal types: square, the size of a schematic toolbar button (a 16 px glyph in
             6,3 padding), each glyph a 16 px path so it sits exactly centred whatever the font. The
             stroke follows the button's foreground, so a checked (accent) button draws it white. -->
        <Style Selector="ToggleButton.type">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>
        <Style Selector="ToggleButton.type Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{Binding $parent[ToggleButton].Foreground}"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="220,*" RowDefinitions="*,Auto" Margin="10">

        <!-- Templates. -->
        <Border Grid.Column="0" BorderThickness="1" BorderBrush="{DynamicResource SystemBaseLowColor}" CornerRadius="3"
                Margin="0,0,10,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Sections}" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="opt:GoalTemplateSection">
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="2,2"/>
                                <ListBox ItemsSource="{Binding Templates}" Background="Transparent"
                                         SelectionChanged="OnTemplateSelected">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="dopt:GoalTemplate">
                                            <TextBlock Text="{Binding Label}" FontSize="12"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="6,2"/>
                                            <Setter Property="MinHeight" Value="0"/>
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Fields. -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="6">
                <!-- The selected template's own choices (port, scale, probe …). -->
                <ItemsControl ItemsSource="{Binding TemplateFields}" IsVisible="{Binding HasTemplateFields}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="opt:GoalTemplateFieldViewModel">
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                <TextBlock Text="{Binding Label}" Classes="label"/>
                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}"
                                          FontSize="12" MinHeight="0" Padding="6,1"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="Name" Classes="label"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Margin="0,1"/>

                    <TextBlock Grid.Row="1" Text="Expression" Classes="label"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Expression}" FontFamily="Menlo, Consolas, monospace"
                             Margin="0,1"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExpressionError}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemErrorTextColor}" IsVisible="{Binding HasExpressionError}"/>

                    <TextBlock Grid.Row="3" Text="Analysis" Classes="label"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AnalysisChoices}"
                              SelectedItem="{Binding Analysis}" FontSize="12" MinHeight="0" Padding="6,1" Margin="0,1"/>

                    <TextBlock Grid.Row="4" Text="Range" Classes="label" IsVisible="{Binding HasRangeAxis}"/>
                    <WrapPanel Grid.Row="4" Grid.Column="1" IsVisible="{Binding HasRangeAxis}">
                        <ComboBox ItemsSource="{Binding AxisChoices}" SelectedItem="{Binding Axis}"
                                  FontSize="12" MinHeight="0" Padding="6,1" Margin="0,1,6,1" IsEnabled="{Binding !WholeRange}"/>
                        <TextBox Text="{Binding RangeLo}" Width="90" PlaceholderText="1 GHz" IsEnabled="{Binding !WholeRange}"
                                 Margin="0,1,4,1"/>
                        <TextBlock Text="to" Classes="label"/>
                        <TextBox Text="{Binding RangeHi}" Width="90" PlaceholderText="2 GHz" IsEnabled="{Binding !WholeRange}"
                                 Margin="0,1,8,1"/>
                        <CheckBox Content="Whole range" FontSize="12" IsChecked="{Binding WholeRange}"/>
                    </WrapPanel>
                </Grid>

                <!-- Type: five toggles, then the limit boxes that type reads. -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Type" Classes="label"/>
                    <ToggleButton Classes="type" IsChecked="{Binding IsLe}" ToolTip.Tip="At or below the limit (le)">
                        <Path Data="M12,2.5 L4,6.5 L12,10.5 M4,13.5 L12,13.5"/>
                    </ToggleButton>
                    <ToggleButton Classes="type" IsChecked="{Binding IsGe}" ToolTip.Tip="At or above the limit (ge)">
                        <Path Data="M4,2.5 L12,6.5 L4,10.5 M4,13.5 L12,13.5"/>
                    </ToggleButton>
                    <ToggleButton Classes="type" IsChecked="{Binding IsEq}" ToolTip.Tip="At the limit (eq)">
                        <Path Data="M3,6 L13,6 M3,10 L13,10"/>
                    </ToggleButton>
                    <!-- Inside: the band's two edges, chevrons pointing in from each. -->
                    <ToggleButton Classes="type" IsChecked="{Binding IsIn}" ToolTip.Tip="Inside a band (in)">
                        <Path Data="M1.5,2.5 L14.5,2.5 M1.5,13.5 L14.5,13.5 M5,5 L8,7.5 L11,5 M5,11 L8,8.5 L11,11"/>
                    </ToggleButton>
                    <!-- Outside: a narrow band, chevrons pointing away from it. -->
                    <ToggleButton Classes="type" IsChecked="{Binding IsOut}" ToolTip.Tip="Outside a band (out)">
                        <Path Data="M1.5,6.5 L14.5,6.5 M1.5,9.5 L14.5,9.5 M5,4 L8,1.5 L11,4 M5,12 L8,14.5 L11,12"/>
                    </ToggleButton>
                </StackPanel>
                <WrapPanel>
                    <TextBlock Text="Limit" Classes="label" IsVisible="{Binding !IsBand}"/>
                    <TextBlock Text="Band" Classes="label" IsVisible="{Binding IsBand}"/>
                    <TextBox Text="{Binding Limit}" Width="100" Margin="0,1,6,1"/>
                    <TextBlock Text="to" Classes="label" IsVisible="{Binding IsBand}"/>
                    <TextBox Text="{Binding UpperLimit}" Width="100" IsVisible="{Binding IsBand}" Margin="0,1,6,1"/>
                    <CheckBox Content="Sloped" FontSize="12" IsChecked="{Binding Sloped}" IsVisible="{Binding CanSlope}"
                              ToolTip.Tip="A limit at each end of the range, interpolated between"/>
                    <TextBlock Text="to" Classes="label" IsVisible="{Binding ShowsLimitAtHi}" Margin="6,0,8,0"/>
                    <TextBox Text="{Binding LimitAtHi}" Width="100" IsVisible="{Binding ShowsLimitAtHi}"
                             ToolTip.Tip="The limit at the high end of the range"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Weight" Classes="label"/>
                    <TextBox Text="{Binding Weight}" Width="70"/>
                    <CheckBox Content="Enabled" FontSize="12" IsChecked="{Binding Enabled}" Margin="12,0,0,0"/>
                </StackPanel>
                <Expander Header="Advanced" FontSize="12" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Scale" Classes="label"/>
                        <TextBox Text="{Binding Scale}" Width="100" PlaceholderText="default"
                                 ToolTip.Tip="What one unit of violation is worth; default is the band's width, or the larger of |limit| and 1"/>
                    </StackPanel>
                </Expander>

                <optv:GoalPreviewPlot Preview="{Binding Preview}" Height="110" IsVisible="{Binding HasPreview}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons. -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" Text="{Binding CommitError}" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemErrorTextColor}" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Content="Cancel" Click="OnCancel" Margin="0,0,6,0" MinWidth="80"/>
            <Button Grid.Column="2" Content="OK" Click="OnOk" IsDefault="True" MinWidth="80"/>
        </Grid>
    </Grid>
</Window>
