<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t3="using:CircuitRF.Ui.ThreeD"
             x:Class="CircuitRF.Ui.Views.ThreeD.C3dPropertiesView"
             x:DataType="t3:C3dPropertiesViewModel">

    <!-- brief-em3d-43 R-em3d43-6b — a 3D view's selection, in the document's display unit. 3D editor round 1: hosted by the
         application's Properties Inspector (the dock panel a schematic and a layout use), not by a panel of the editor's own. -->
    <UserControl.Styles>
        <Style Selector="TextBox.error">
            <Setter Property="BorderBrush" Value="IndianRed"/>
        </Style>
        <!-- 3D editor round 4 — a dimension's box: narrow enough for x, y and z to share a line. -->
        <Style Selector="TextBox.dim">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="6" Margin="8,6">
            <SelectableTextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap"/>

            <StackPanel Spacing="4" IsVisible="{Binding IsEditable}">
                <TextBlock Text="Name" FontSize="11" Opacity="0.7"/>
                <TextBox x:Name="NameBox" Text="{Binding NameText}" KeyDown="OnNameKey" LostFocus="OnNameLostFocus"/>
                <TextBlock Text="Material" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding Material}" HorizontalAlignment="Stretch"
                          PlaceholderText="{Binding MaterialPlaceholder}" IsEnabled="{Binding IsMaterialEditable}"/>
                <TextBlock Text="Role" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Static t3:C3dPropertiesViewModel.Roles}" SelectedItem="{Binding Role}" HorizontalAlignment="Stretch"
                          PlaceholderText="{Binding RolePlaceholder}" IsEnabled="{Binding IsMaterialEditable}"
                          ToolTip.Tip="What the solver treats the object as. From material: the material decides."/>
                <!-- 3D editor round 3 — a bond wire has no placement: its points are world points (below). Round 4: the
                     placement origin is edited on its one line among the dimensions below, not twice. -->
                <StackPanel Spacing="4" IsVisible="{Binding IsPlaced}">
                    <TextBlock Text="Rotations, in order" FontSize="11" Opacity="0.7"/>
                    <TextBox Text="{Binding RotateText}" PlaceholderText="z 30, x 90" KeyDown="OnRotateKey" LostFocus="OnRotateLostFocus"/>
                    <CheckBox IsChecked="{Binding MirrorX}" Content="Mirror x"/>
                </StackPanel>
            </StackPanel>

            <!-- brief-em3d-66 R-em3d66-4 — a boolean: each field one undo entry, re-evaluated at once. An evaluation that
                 fails is not rolled back: the node carries the refusal, and undo is one keystroke away. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsBoolean}">
                <TextBlock Text="Operation" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.BooleanOps}" SelectedItem="{Binding BooleanOperation}"
                          HorizontalAlignment="Stretch" IsEnabled="{Binding BooleanEditable}" ToolTip.Tip="{Binding BooleanTip}"/>
                <CheckBox IsChecked="{Binding BooleanEnabled}" Content="Enabled" IsEnabled="{Binding BooleanEditable}"
                          ToolTip.Tip="Unticked, the Blank and the Tools are objects of their own — drawn, edited and simulated — as Dissolve would write them."/>
                <CheckBox IsChecked="{Binding BooleanKeepTools}" Content="Keep tools" IsEnabled="{Binding BooleanKeepToolsEnabled}"
                          ToolTip.Tip="{x:Static t3:C3dEditorViewModel.BooleanKeepToolsTip}"/>
                <TextBlock Text="Blank" FontSize="11" Opacity="0.7"/>
                <Grid ColumnDefinitions="*,Auto">
                    <ComboBox ItemsSource="{Binding BooleanOperands}" SelectedItem="{Binding BooleanBlank}" HorizontalAlignment="Stretch"
                              IsEnabled="{Binding BooleanEditable}"
                              ToolTip.Tip="The object the Tools act on. The boolean takes its name; the old Blank becomes a Tool."/>
                    <Button Grid.Column="1" Content="Swap" Margin="4,0,0,0" Command="{Binding SwapBooleanCommand}" IsVisible="{Binding BooleanCanSwap}"
                            ToolTip.Tip="The Tool becomes the Blank, and the Blank the Tool."/>
                </Grid>
            </StackPanel>

            <!-- brief-em3d-67 R-em3d67-6b — a fillet's or chamfer's row: each field one undo entry, re-evaluated through the
                 client. An evaluation that fails is not rolled back: the row carries the refusal. Its size fields are the
                 dimension lines below (a number or an expression). -->
            <StackPanel Spacing="4" IsVisible="{Binding IsFeature}">
                <CheckBox IsChecked="{Binding FeatureEnabled}" Content="Enabled" IsEnabled="{Binding FeatureEditable}"
                          ToolTip.Tip="Unticked, the solid elaborates unrounded — a cheap A/B for the simulation."/>
                <Button Content="Flip" Command="{Binding FlipChamferCommand}" IsVisible="{Binding FeatureCanFlip}" HorizontalAlignment="Left"
                        ToolTip.Tip="Measure the first distance on the edge's other face."/>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                    <TextBlock Text="Edges" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Show" Command="{Binding ShowFeatureEdgesCommand}"
                            ToolTip.Tip="Select them in the view (Edge mode)."/>
                    <Button Grid.Column="2" Content="Edit…" Command="{Binding EditFeatureEdgesCommand}" IsEnabled="{Binding FeatureEditable}"
                            ToolTip.Tip="{Binding FeatureTip}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding FeatureEdges}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Text="{Binding}" FontSize="11"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Remove" Command="{Binding RemoveFeatureCommand}" HorizontalAlignment="Left"
                        ToolTip.Tip="The solid returns unrounded, in its place and under its name. One undo entry."/>
            </StackPanel>

            <!-- 3D editor round 3 — a bond wire: its bonds, its section, and every point of its axis in world coordinates.
                 A point commits on Enter or lost focus (one undo entry); an end is re-seated on its pad's top as a drag's is. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsWire}">
                <Grid ColumnDefinitions="*,6,*">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Start bond" FontSize="11" Opacity="0.7"/>
                        <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.BondStyles}" SelectedItem="{Binding WireStartStyle}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="End bond" FontSize="11" Opacity="0.7"/>
                        <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.BondStyles}" SelectedItem="{Binding WireEndStyle}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Section" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.WireSections}" SelectedItem="{Binding WireSection}" HorizontalAlignment="Stretch"/>
                <!-- 3D editor round 4 — loop height and span, as a wBond or Layout wire offers them. -->
                <Grid ColumnDefinitions="Auto,*,8,Auto,*,Auto" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Text="Loop height:" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="1" Text="{Binding WireLoopHeight}" Classes="dim" PlaceholderText="no pad"
                             KeyDown="OnWireLoopHeightKey" LostFocus="OnWireLoopHeightLostFocus"
                             ToolTip.Tip="From the top of the lower pad to the top of the wire at its apex. Every x and y is kept; the rise above the feet scales."/>
                    <TextBlock Grid.Column="3" Text="Span:" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="4" Text="{Binding WireSpan}" Classes="dim"
                             KeyDown="OnWireSpanKey" LostFocus="OnWireSpanLostFocus"
                             ToolTip.Tip="Foot to foot, in plan. The end moves along the wire's direction and lands on the pad under it; the start stays."/>
                    <TextBlock Grid.Column="5" Text="{Binding LengthUnit}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </Grid>
                <TextBlock Text="Points (x, y, z)" FontSize="11" Opacity="0.7" Margin="0,4,0,0"
                           ToolTip.Tip="The wire's axis, start to end, in world coordinates. Each end sits on the top of its pad."/>
                <ItemsControl ItemsSource="{Binding WirePoints}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="t3:C3dWirePointRow">
                            <Grid ColumnDefinitions="36,*,3,*,3,*" Margin="0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding X}" FontSize="11" Padding="3,1" KeyDown="OnWirePointKey" LostFocus="OnWirePointLostFocus"/>
                                <TextBox Grid.Column="3" Text="{Binding Y}" FontSize="11" Padding="3,1" KeyDown="OnWirePointKey" LostFocus="OnWirePointLostFocus"/>
                                <TextBox Grid.Column="5" Text="{Binding Z}" FontSize="11" Padding="3,1" KeyDown="OnWirePointKey" LostFocus="OnWirePointLostFocus"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- brief-em3d-47 R-em3d47-3e — Set Coordinates: the typed Vertex Move, world, in the display unit. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsVertexEditable}">
                <TextBlock Text="Set coordinates (x, y, z)" FontSize="11" Opacity="0.7"/>
                <Grid ColumnDefinitions="*,4,*,4,*">
                    <TextBox Grid.Column="0" Text="{Binding VertexX}" KeyDown="OnVertexKey" LostFocus="OnVertexLostFocus"/>
                    <TextBox Grid.Column="2" Text="{Binding VertexY}" KeyDown="OnVertexKey" LostFocus="OnVertexLostFocus"/>
                    <TextBox Grid.Column="4" Text="{Binding VertexZ}" KeyDown="OnVertexKey" LostFocus="OnVertexLostFocus"/>
                </Grid>
            </StackPanel>

            <!-- 3D editor round 3 — what fills the air box: Air by default, Vacuum or any technology material by choice. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsAirBoxRow}">
                <TextBlock Text="Material" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{Binding AirBoxMaterials}" SelectedItem="{Binding AirBoxMaterial}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="What fills the air box where no object is. Air by default; pick Vacuum for free space."/>
            </StackPanel>

            <!-- 3D editor round 1 — the air box: padding per axis as a share of the content's extent, and each face's boundary. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsAirBox}">
                <TextBlock Text="Padding, % of the content's extent (each side)" FontSize="11" Opacity="0.7"
                           ToolTip.Tip="10 on X pads a tenth of the design's x-extent beyond it on each side. Empty: the faces keep their own padding (a stated distance, or the default)."/>
                <Grid ColumnDefinitions="Auto,*,6,Auto,*,6,Auto,*">
                    <TextBlock Grid.Column="0" Text="X" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="1" Text="{Binding PadXPercent}" Tag="x" PlaceholderText="—" KeyDown="OnPadKey" LostFocus="OnPadLostFocus"/>
                    <TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="4" Text="{Binding PadYPercent}" Tag="y" PlaceholderText="—" KeyDown="OnPadKey" LostFocus="OnPadLostFocus"/>
                    <TextBlock Grid.Column="6" Text="Z" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="7" Text="{Binding PadZPercent}" Tag="z" PlaceholderText="—" KeyDown="OnPadKey" LostFocus="OnPadLostFocus"/>
                </Grid>
                <TextBlock Text="Faces" FontSize="11" Opacity="0.7" Margin="0,4,0,0"/>
                <ItemsControl ItemsSource="{Binding AirBoxFaces}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="t3:C3dAirBoxFaceRow">
                            <Grid ColumnDefinitions="44,*,Auto" Margin="0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Face}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static t3:C3dPropertiesViewModel.BoundaryKinds}"
                                          SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch" FontSize="11"/>
                                <SelectableTextBlock Grid.Column="2" Text="{Binding Padding}" FontSize="11" Opacity="0.8"
                                                     VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <SelectableTextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- brief-em3d-51 R-em3d51-4b — each named dimension: its expression and resolved value, editable as either.
                 3D editor round 4 — a vector's components share one line ("Size: x [ ] y [ ] z [ ]"), labels aligned. -->
            <ItemsControl ItemsSource="{Binding FieldRows}" IsVisible="{Binding FieldsVisible}" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="t3:C3dDimensionRow">
                        <StackPanel Margin="0,2" Spacing="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DimLabel"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DimUnit"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label, StringFormat='{}{0}:'}" FontSize="11" Opacity="0.7"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="t3:C3dDimensionField">
                                            <DockPanel Margin="0,0,4,0">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Axis, StringFormat='{}{0}:'}" FontSize="11" Opacity="0.7"
                                                           VerticalAlignment="Center" Margin="0,0,2,0"
                                                           IsVisible="{Binding Axis, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                <TextBox Text="{Binding Text}" Classes="dim" ToolTip.Tip="{Binding Path}"
                                                         KeyDown="OnDimensionKey" LostFocus="OnDimensionLostFocus"
                                                         Classes.error="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="2" Text="{Binding Unit}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                            </Grid>
                            <SelectableTextBlock Text="{Binding Notes}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"
                                                 IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <SelectableTextBlock Text="{Binding Errors}" FontSize="11" Foreground="IndianRed" TextWrapping="Wrap"
                                                 IsVisible="{Binding Errors, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="t3:C3dPropertyRow">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.7"/>
                            <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
