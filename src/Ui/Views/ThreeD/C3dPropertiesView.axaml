<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t3="using:CircuitRF.Ui.ThreeD"
             x:Class="CircuitRF.Ui.Views.ThreeD.C3dPropertiesView"
             x:DataType="t3:C3dPropertiesViewModel">

    <!-- brief-em3d-43 R-em3d43-6b — a 3D view's selection, in the document's display unit. 3D editor round 1: hosted by the
         application's Properties Inspector (the dock panel a schematic and a layout use), not by a panel of the editor's own. -->
    <UserControl.Styles>
        <Style Selector="TextBox.error">
            <Setter Property="BorderBrush" Value="IndianRed"/>
        </Style>
        <!-- 3D editor round 4 — a dimension's box: narrow enough for x, y and z to share a line. -->
        <Style Selector="TextBox.dim">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="6" Margin="8,6">
            <SelectableTextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap"/>

            <StackPanel Spacing="4" IsVisible="{Binding IsEditable}">
                <TextBlock Text="Name" FontSize="11" Opacity="0.7"/>
                <TextBox x:Name="NameBox" Text="{Binding NameText}" KeyDown="OnNameKey" LostFocus="OnNameLostFocus"/>
                <TextBlock Text="Material" FontSize="11" Opacity="0.7"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding Materials}" SelectedItem="{Binding Material}" HorizontalAlignment="Stretch"
                              PlaceholderText="{Binding MaterialPlaceholder}" IsEnabled="{Binding IsMaterialEditable}"/>
                    <Button Grid.Column="1" Content="Edit…" FontSize="11" Padding="8,3" VerticalAlignment="Stretch"
                            Command="{Binding EditMaterialsCommand}" IsEnabled="{Binding IsMaterialEditable}"
                            ToolTip.Tip="Open the Materials editor on this material: every property it states, and the technology's other materials — see, edit, duplicate or make one, then assign it."/>
                </Grid>
                <TextBlock Text="Role" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Static t3:C3dPropertiesViewModel.Roles}" SelectedItem="{Binding Role}" HorizontalAlignment="Stretch"
                          PlaceholderText="{Binding RolePlaceholder}" IsEnabled="{Binding IsMaterialEditable}"
                          ToolTip.Tip="What the solver treats the object as. From material: the material decides."/>
                <!-- 3D editor round 3 — a bond wire has no placement: its points are world points (below). Round 4: the
                     placement origin is edited on its one line among the dimensions below, not twice. -->
                <StackPanel Spacing="4" IsVisible="{Binding IsPlaced}">
                    <TextBlock Text="Rotations, in order" FontSize="11" Opacity="0.7"/>
                    <TextBox Text="{Binding RotateText}" PlaceholderText="z 30, x 90" KeyDown="OnRotateKey" LostFocus="OnRotateLostFocus"/>
                    <CheckBox IsChecked="{Binding MirrorX}" Content="Mirror x"/>
                </StackPanel>
            </StackPanel>

            <!-- brief-em3d-93 R-em3d93-4 — in the solve or not: an object, an instance, a group whole, a multi-selection, the
                 selected ports or a heat source. Indeterminate where the members differ; a click writes every one, one undo entry. -->
            <CheckBox Content="Model" IsVisible="{Binding HasModel}" IsChecked="{Binding ModelChecked}" IsThreeState="False"
                      ToolTip.Tip="{Binding ModelTip}"/>

            <!-- brief-em3d-92 R-em3d92-3 — how see-through the selection is drawn, independent of its material's colour: an
                 object, an instance, a group whole (every member) or a multi-selection. The slider previews while dragged and
                 writes ONE undo entry on release; the box takes a whole number; Default clears it back to the kind's. -->
            <StackPanel Spacing="4" IsVisible="{Binding HasTransparency}">
                <TextBlock Text="Transparency" FontSize="11" Opacity="0.7"/>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                    <Slider x:Name="TransparencySlider" Grid.Column="0" Minimum="0" Maximum="{x:Static t3:C3dPropertiesViewModel.TransparencyMax}"
                            Value="{Binding TransparencySlider}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ToolTip.Tip="How see-through it is drawn, percent. Drag to preview; the value is kept when you let go."/>
                    <TextBox Grid.Column="1" Width="92" Text="{Binding TransparencyText}" PlaceholderText="{Binding TransparencyPlaceholder}"
                             KeyDown="OnTransparencyKey" LostFocus="OnTransparencyLostFocus"
                             ToolTip.Tip="A whole number, percent. Empty shows the kind's default greyed, or 'mixed' where the selection differs."/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="Default" FontSize="11" Padding="8,3" Command="{Binding ResetTransparencyCommand}"
                            ToolTip.Tip="Draw it as its kind is drawn: a dielectric translucent, a conductor opaque."/>
                </Grid>
            </StackPanel>

            <!-- brief-em3d-66 R-em3d66-4 — a boolean: each field one undo entry, re-evaluated at once. An evaluation that
                 fails is not rolled back: the node carries the refusal, and undo is one keystroke away. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsBoolean}">
                <TextBlock Text="Operation" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.BooleanOps}" SelectedItem="{Binding BooleanOperation}"
                          HorizontalAlignment="Stretch" IsEnabled="{Binding BooleanEditable}" ToolTip.Tip="{Binding BooleanTip}"/>
                <CheckBox IsChecked="{Binding BooleanEnabled}" Content="Enabled" IsEnabled="{Binding BooleanEditable}"
                          ToolTip.Tip="Unticked, the Blank and the Tools are objects of their own — drawn, edited and simulated — as Dissolve would write them."/>
                <CheckBox IsChecked="{Binding BooleanKeepTools}" Content="Keep tools" IsEnabled="{Binding BooleanKeepToolsEnabled}"
                          ToolTip.Tip="{x:Static t3:C3dEditorViewModel.BooleanKeepToolsTip}"/>
                <TextBlock Text="Blank" FontSize="11" Opacity="0.7"/>
                <Grid ColumnDefinitions="*,Auto">
                    <ComboBox ItemsSource="{Binding BooleanOperands}" SelectedItem="{Binding BooleanBlank}" HorizontalAlignment="Stretch"
                              IsEnabled="{Binding BooleanEditable}"
                              ToolTip.Tip="The object the Tools act on. The boolean takes its name; the old Blank becomes a Tool."/>
                    <Button Grid.Column="1" Content="Swap" Margin="4,0,0,0" Command="{Binding SwapBooleanCommand}" IsVisible="{Binding BooleanCanSwap}"
                            ToolTip.Tip="The Tool becomes the Blank, and the Blank the Tool."/>
                </Grid>
            </StackPanel>

            <!-- brief-em3d-67 R-em3d67-6b — a fillet's or chamfer's row: each field one undo entry, re-evaluated through the
                 client. An evaluation that fails is not rolled back: the row carries the refusal. Its size fields are the
                 dimension lines below (a number or an expression). -->
            <StackPanel Spacing="4" IsVisible="{Binding IsFeature}">
                <CheckBox IsChecked="{Binding FeatureEnabled}" Content="Enabled" IsEnabled="{Binding FeatureEditable}"
                          ToolTip.Tip="Unticked, the solid elaborates unrounded — a cheap A/B for the simulation."/>
                <Button Content="Flip" Command="{Binding FlipChamferCommand}" IsVisible="{Binding FeatureCanFlip}" HorizontalAlignment="Left"
                        ToolTip.Tip="Measure the first distance on the edge's other face."/>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                    <TextBlock Text="Edges" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Show" Command="{Binding ShowFeatureEdgesCommand}"
                            ToolTip.Tip="Select them in the view (Edge mode)."/>
                    <Button Grid.Column="2" Content="Edit…" Command="{Binding EditFeatureEdgesCommand}" IsEnabled="{Binding FeatureEditable}"
                            ToolTip.Tip="{Binding FeatureTip}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding FeatureEdges}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Text="{Binding}" FontSize="11"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Remove" Command="{Binding RemoveFeatureCommand}" HorizontalAlignment="Left"
                        ToolTip.Tip="The solid returns unrounded, in its place and under its name. One undo entry."/>
            </StackPanel>

            <!-- 3D editor round 3 — a bond wire: its bonds, its section, and every point of its axis in world coordinates.
                 A point commits on Enter or lost focus (one undo entry); an end is re-seated on its pad's top as a drag's is. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsWire}">
                <Grid ColumnDefinitions="*,6,*">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Start bond" FontSize="11" Opacity="0.7"/>
                        <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.BondStyles}" SelectedItem="{Binding WireStartStyle}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="End bond" FontSize="11" Opacity="0.7"/>
                        <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.BondStyles}" SelectedItem="{Binding WireEndStyle}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Section" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.WireSections}" SelectedItem="{Binding WireSection}" HorizontalAlignment="Stretch"/>
                <!-- 3D editor round 4 — loop height and span, as a wBond or Layout wire offers them. -->
                <Grid ColumnDefinitions="Auto,*,8,Auto,*,Auto" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Text="Loop height:" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="1" Text="{Binding WireLoopHeight}" Classes="dim" PlaceholderText="no pad"
                             KeyDown="OnWireLoopHeightKey" LostFocus="OnWireLoopHeightLostFocus"
                             ToolTip.Tip="From the top of the lower pad to the top of the wire at its apex. Every x and y is kept; the rise above the feet scales."/>
                    <TextBlock Grid.Column="3" Text="Span:" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="4" Text="{Binding WireSpan}" Classes="dim"
                             KeyDown="OnWireSpanKey" LostFocus="OnWireSpanLostFocus"
                             ToolTip.Tip="Foot to foot, in plan. The end moves along the wire's direction and lands on the pad under it; the start stays."/>
                    <TextBlock Grid.Column="5" Text="{Binding LengthUnit}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </Grid>
                <TextBlock Text="Points (x, y, z)" FontSize="11" Opacity="0.7" Margin="0,4,0,0"
                           ToolTip.Tip="The wire's axis, start to end, in world coordinates. Each end sits on the top of its pad."/>
                <ItemsControl ItemsSource="{Binding WirePoints}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="t3:C3dWirePointRow">
                            <Grid ColumnDefinitions="36,*,3,*,3,*" Margin="0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding X}" FontSize="11" Padding="3,1" KeyDown="OnWirePointKey" LostFocus="OnWirePointLostFocus"/>
                                <TextBox Grid.Column="3" Text="{Binding Y}" FontSize="11" Padding="3,1" KeyDown="OnWirePointKey" LostFocus="OnWirePointLostFocus"/>
                                <TextBox Grid.Column="5" Text="{Binding Z}" FontSize="11" Padding="3,1" KeyDown="OnWirePointKey" LostFocus="OnWirePointLostFocus"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- brief-em3d-47 R-em3d47-3e — Set Coordinates: the typed Vertex Move, world, in the display unit. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsVertexEditable}">
                <TextBlock Text="Set coordinates (x, y, z)" FontSize="11" Opacity="0.7"/>
                <Grid ColumnDefinitions="*,4,*,4,*">
                    <TextBox Grid.Column="0" Text="{Binding VertexX}" KeyDown="OnVertexKey" LostFocus="OnVertexLostFocus"/>
                    <TextBox Grid.Column="2" Text="{Binding VertexY}" KeyDown="OnVertexKey" LostFocus="OnVertexLostFocus"/>
                    <TextBox Grid.Column="4" Text="{Binding VertexZ}" KeyDown="OnVertexKey" LostFocus="OnVertexLostFocus"/>
                </Grid>
            </StackPanel>

            <!-- 3D editor round 3 — what fills the air box: Air by default, Vacuum or any technology material by choice. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsAirBoxRow}">
                <TextBlock Text="Material" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{Binding AirBoxMaterials}" SelectedItem="{Binding AirBoxMaterial}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="What fills the air box where no object is. Air by default; pick Vacuum for free space."/>
            </StackPanel>

            <!-- 3D editor round 1 — the air box: padding per axis as a share of the content's extent, and each face's boundary. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsAirBox}">
                <TextBlock Text="Padding, % of the content's extent (each side)" FontSize="11" Opacity="0.7"
                           ToolTip.Tip="10 on X pads a tenth of the design's x-extent beyond it on each side. Empty: the faces keep their own padding (a stated distance, or the default)."/>
                <Grid ColumnDefinitions="Auto,*,6,Auto,*,6,Auto,*">
                    <TextBlock Grid.Column="0" Text="X" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="1" Text="{Binding PadXPercent}" Tag="x" PlaceholderText="—" KeyDown="OnPadKey" LostFocus="OnPadLostFocus"/>
                    <TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="4" Text="{Binding PadYPercent}" Tag="y" PlaceholderText="—" KeyDown="OnPadKey" LostFocus="OnPadLostFocus"/>
                    <TextBlock Grid.Column="6" Text="Z" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="7" Text="{Binding PadZPercent}" Tag="z" PlaceholderText="—" KeyDown="OnPadKey" LostFocus="OnPadLostFocus"/>
                </Grid>
                <TextBlock Text="Faces" FontSize="11" Opacity="0.7" Margin="0,4,0,0"/>
                <ItemsControl ItemsSource="{Binding AirBoxFaces}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="t3:C3dAirBoxFaceRow">
                            <Grid ColumnDefinitions="44,*,Auto" Margin="0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Face}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static t3:C3dPropertiesViewModel.BoundaryKinds}"
                                          SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch" FontSize="11"/>
                                <SelectableTextBlock Grid.Column="2" Text="{Binding Padding}" FontSize="11" Opacity="0.8"
                                                     VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- brief-em3d-75 R-em3d75-1c — a heat source, probe or mesh region: its name and its other fields (its
                 dimensions are the ordinary dimension lines below, expressions included). -->
            <StackPanel Spacing="4" IsVisible="{Binding IsThermalPlace}">
                <TextBlock Text="Name" FontSize="11" Opacity="0.7"/>
                <TextBox Text="{Binding NameText}" KeyDown="OnNameKey" LostFocus="OnNameLostFocus"
                         ToolTip.Tip="A measure names a probe by it; a setup names a heat source by it. Renaming rewrites both."/>
                <ItemsControl ItemsSource="{Binding ThermalFields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="t3:C3dThermalTextField">
                            <StackPanel Margin="0,2" Spacing="1">
                                <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.7"/>
                                <TextBox Text="{Binding Text}" PlaceholderText="{Binding Hint}" ToolTip.Tip="{Binding Hint}"
                                         KeyDown="OnThermalFieldKey" LostFocus="OnThermalFieldLostFocus"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- brief-em3d-90 R-em3d90-4 — a thermal boundary of the active thermal setup: each commit is right-click ▸ Thermal's
                 own write (one undo entry). Switching the kind keeps the other kind's values while the row stays selected. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsThermalBoundary}">
                <TextBlock Text="Kind" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Static t3:C3dPropertiesViewModel.ThermalBoundaryKinds}" SelectedItem="{Binding BoundaryKind}"
                          HorizontalAlignment="Stretch" IsEnabled="{Binding BoundaryEditable}"
                          ToolTip.Tip="A fixed temperature, or convection to an ambient. Every face no boundary names is insulated."/>
                <StackPanel Spacing="4" IsVisible="{Binding BoundaryIsFixed}">
                    <TextBlock Text="T, °C" FontSize="11" Opacity="0.7"/>
                    <TextBox Text="{Binding BoundaryT}" IsEnabled="{Binding BoundaryEditable}" KeyDown="OnBoundaryKey" LostFocus="OnBoundaryLostFocus"
                             ToolTip.Tip="A number or an expression, in °C"/>
                </StackPanel>
                <StackPanel Spacing="4" IsVisible="{Binding !BoundaryIsFixed}">
                    <TextBlock Text="h, W/(m²·K)" FontSize="11" Opacity="0.7"/>
                    <TextBox Text="{Binding BoundaryH}" IsEnabled="{Binding BoundaryEditable}" KeyDown="OnBoundaryKey" LostFocus="OnBoundaryLostFocus"
                             ToolTip.Tip="The heat transfer coefficient: a number or an expression"/>
                    <TextBlock Text="Ambient, °C" FontSize="11" Opacity="0.7"/>
                    <TextBox Text="{Binding BoundaryAmbient}" IsEnabled="{Binding BoundaryEditable}" KeyDown="OnBoundaryKey" LostFocus="OnBoundaryLostFocus"
                             ToolTip.Tip="A number or an expression, in °C"/>
                </StackPanel>
                <TextBlock Text="Face" FontSize="11" Opacity="0.7"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <SelectableTextBlock Text="{Binding BoundaryFace}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Content="Select face" FontSize="11" Padding="8,3" Command="{Binding SelectBoundaryFaceCommand}"
                            ToolTip.Tip="Select the face this boundary lies on, in Face mode (B from the boundary in the view reaches it too)."/>
                </Grid>
            </StackPanel>

            <!-- brief-em3d-83 R-em3d83-4 — a field plot: every field one undo entry. The Solution picker lists what the run
                 saved, by value; the Quantity picker only what the step offers. The phase controls at the foot are the view's. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsFieldPlot}">
                <SelectableTextBlock Text="{Binding PlotProblem}" Foreground="{DynamicResource CrfWarningBrush}" TextWrapping="Wrap" FontSize="11"
                                     IsVisible="{Binding PlotProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <SelectableTextBlock Text="{Binding PlotStale}" Foreground="{DynamicResource CrfWarningBrush}" TextWrapping="Wrap" FontSize="11"
                                     IsVisible="{Binding PlotStale, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Text="Name" FontSize="11" Opacity="0.7"/>
                <TextBox Text="{Binding NameText}" KeyDown="OnNameKey" LostFocus="OnNameLostFocus"/>
                <TextBlock Text="Setup" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{Binding PlotSetups}" SelectedItem="{Binding PlotSetup}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="The setup whose run the plot reads. Active follows whichever setup is active when it is drawn."/>
                <TextBlock Text="Solver" FontSize="11" Opacity="0.7" IsVisible="{Binding PlotHasSolver}"/>
                <ComboBox ItemsSource="{x:Static t3:C3dPropertiesViewModel.PlotSolvers}" SelectedItem="{Binding PlotSolver}"
                          HorizontalAlignment="Stretch" IsVisible="{Binding PlotHasSolver}"
                          ToolTip.Tip="A setup that runs both solvers saves two sets of fields: which one this plot draws."/>
                <TextBlock Text="Solution" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{Binding PlotSolutions}" SelectedItem="{Binding PlotSolution}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="What the run saved: a frequency (driven), a mode (eigenmode), a terminal (static), a sweep point (thermal). The plot keeps the VALUE, so a run that saves more never moves it."/>
                <StackPanel Spacing="2" IsVisible="{Binding PlotOtherOpen}">
                    <TextBlock Text="Other frequency, GHz — saved by the next run" FontSize="11" Opacity="0.7"/>
                    <TextBox Text="{Binding PlotOtherText}" PlaceholderText="e.g. 6" KeyDown="OnPlotOtherKey"
                             ToolTip.Tip="Added to the setup's Save fields at, and this plot moved to it. The plot says it is missing until you Simulate again."/>
                </StackPanel>
                <TextBlock Text="Quantity" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{Binding PlotQuantities}" SelectedItem="{Binding PlotQuantity}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="What is drawn — only what the solver's files hold is offered."/>
                <TextBlock Text="On" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{Binding PlotTargets}" SelectedItem="{Binding PlotTarget}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="Where it is drawn: a cut on the plot's own plane; surfaces (the selected solid's faces, or the conductors for J_s; every exposed face for a temperature); or the faces it lists."/>
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="4" IsVisible="{Binding PlotIsClip}">
                    <TextBlock Text="Across" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{x:Static t3:C3dPropertiesViewModel.PlotAxes}" SelectedItem="{Binding PlotAxis}"
                              ToolTip.Tip="The axis the plane is square to: the plot owns its plane, so two plots cut in two places."/>
                    <TextBox Grid.Column="2" Text="{Binding PlotOffsetText}" Classes="dim" KeyDown="OnPlotOffsetKey" LostFocus="OnPlotOffsetLostFocus"
                             ToolTip.Tip="Where the plane is along its axis, in the display unit (or with a unit of its own)."/>
                    <TextBlock Grid.Column="3" Text="{Binding LengthUnit}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Spacing="1" IsVisible="{Binding PlotIsFaces}">
                    <TextBlock Text="Faces" FontSize="11" Opacity="0.7"/>
                    <SelectableTextBlock Text="{Binding PlotFacesText}" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !PlotIsTemperature}">
                    <CheckBox IsChecked="{Binding PlotDb}" Content="dB" ToolTip.Tip="Decibels (20·log10 of the amplitude), 40 dB below the top of the range"/>
                    <TextBlock Text="Top of range" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{x:Static t3:C3dPropertiesViewModel.PlotPercentiles}" SelectedItem="{Binding PlotPercentile}"
                              ToolTip.Tip="This percentile of the values drawn, so one singular edge does not wash out the picture. Beyond it, the end colour.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat='{}{0} %'}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <CheckBox IsChecked="{Binding PlotFixRange}" Content="Fix range across the sweep" IsVisible="{Binding PlotIsTemperature}"
                          ToolTip.Tip="The colour range is the minimum and maximum over EVERY sweep point, so stepping the sweep never rescales. Off: each point its own true minimum and maximum."/>
                <!-- The view's: the phase animation of the plot being drawn. Not saved. -->
                <StackPanel Spacing="4" Margin="0,6,0,0" IsVisible="{Binding PlotIsDrawn}">
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !PlotIsTemperature}">
                        <ToggleButton IsChecked="{Binding Viewer.FieldPlaying}" IsEnabled="{Binding Viewer.FieldCanAnimate}"
                                      ToolTip.Tip="Play the phase: Re{v·e^jφ} through one cycle (choose an animated quantity)" ToolTip.ShowOnDisabled="True">
                            <TextBlock Text="▶ ❚❚"/>
                        </ToggleButton>
                        <Slider Width="120" Minimum="0" Maximum="360" Value="{Binding Viewer.FieldPhaseDegrees}"
                                IsEnabled="{Binding Viewer.FieldCanAnimate}" VerticalAlignment="Center" ToolTip.Tip="Phase φ, degrees — the view's, not saved"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !PlotIsTemperature}">
                        <NumericUpDown Value="{Binding Viewer.FieldLoopSeconds}" Minimum="0.2" Maximum="30" Increment="0.5" FormatString="0.#"
                                       IsEnabled="{Binding Viewer.FieldCanAnimate}" Width="100"
                                       ToolTip.Tip="Seconds per cycle on screen — a display choice; the frequency is the legend's"/>
                        <TextBlock Text="s / cycle" VerticalAlignment="Center" Opacity="0.7" FontSize="11"/>
                    </StackPanel>
                    <SelectableTextBlock Text="{Binding Viewer.FieldText}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"
                                         IsVisible="{Binding Viewer.FieldText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </StackPanel>

            <SelectableTextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- brief-em3d-51 R-em3d51-4b — each named dimension: its expression and resolved value, editable as either.
                 3D editor round 4 — a vector's components share one line ("Size: x [ ] y [ ] z [ ]"), labels aligned. -->
            <ItemsControl ItemsSource="{Binding FieldRows}" IsVisible="{Binding FieldsVisible}" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="t3:C3dDimensionRow">
                        <StackPanel Margin="0,2" Spacing="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DimLabel"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DimUnit"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label, StringFormat='{}{0}:'}" FontSize="11" Opacity="0.7"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="t3:C3dDimensionField">
                                            <DockPanel Margin="0,0,4,0">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Axis, StringFormat='{}{0}:'}" FontSize="11" Opacity="0.7"
                                                           VerticalAlignment="Center" Margin="0,0,2,0"
                                                           IsVisible="{Binding Axis, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                <TextBox Text="{Binding Text}" Classes="dim" ToolTip.Tip="{Binding Path}"
                                                         KeyDown="OnDimensionKey" LostFocus="OnDimensionLostFocus"
                                                         Classes.error="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="2" Text="{Binding Unit}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                            </Grid>
                            <SelectableTextBlock Text="{Binding Notes}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"
                                                 IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <SelectableTextBlock Text="{Binding Errors}" FontSize="11" Foreground="IndianRed" TextWrapping="Wrap"
                                                 IsVisible="{Binding Errors, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="t3:C3dPropertyRow">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.7"/>
                            <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
