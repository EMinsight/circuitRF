<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t3="using:CircuitRF.Ui.ThreeD"
        x:Class="CircuitRF.Ui.Views.ThreeD.StepExportDialog"
        x:DataType="t3:StepExportDialogViewModel"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <!-- brief-em3d-69 R-em3d69-4a: the options, the summary line before writing, then Export with progress and Cancel. -->
    <StackPanel Margin="16,12,16,12" Spacing="6">
        <SelectableTextBlock Text="{Binding TargetPath}" FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource SystemBaseMediumColor}"/>

        <TextBlock Text="Structure" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0"/>
        <RadioButton GroupName="structure" Content="Flattened: one product per solid" IsChecked="{Binding Flattened}"
                     IsEnabled="{Binding !Writing}"/>
        <RadioButton GroupName="structure" Content="As assembly: each placed cell a sub-assembly, written once" IsChecked="{Binding Assembly}"
                     IsEnabled="{Binding !Writing}"/>
        <TextBlock Text="Precedence is applied within each sub-assembly, not across them: an assembly's instances are one shape."
                   FontSize="11" TextWrapping="Wrap" Margin="24,0,0,0" IsVisible="{Binding Assembly}"
                   Foreground="{DynamicResource SystemBaseMediumColor}"/>

        <TextBlock Text="Overlaps" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0"/>
        <RadioButton GroupName="overlap" Content="Precedence applied: disjoint solids, as the solver gets them" IsChecked="{Binding PrecedenceApplied}"
                     IsEnabled="{Binding !Writing}"
                     ToolTip.Tip="Metal over dielectric, then construction order: a via is a hole through the substrate with the via in it."/>
        <RadioButton GroupName="overlap" Content="As drawn: every solid whole, overlapping where it was drawn" IsChecked="{Binding AsDrawn}"
                     IsEnabled="{Binding !Writing}"/>

        <CheckBox Content="Thicken sheets (each a thin solid of its stated thickness)" IsChecked="{Binding ThickenSheets}" Margin="0,6,0,0"
                  IsEnabled="{Binding !Writing}" ToolTip.Tip="For a receiving tool that drops surfaces. Off, a sheet is written as the face the solver gets."/>
        <CheckBox Content="Include air box (one solid, 'airbox', uncoloured)" IsChecked="{Binding IncludeAirBox}"
                  IsEnabled="{Binding !Writing}" ToolTip.Tip="A solver construct, not a part: for checking clearances to a housing."/>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <TextBlock Text="Schema" VerticalAlignment="Center" FontSize="12"/>
            <ComboBox ItemsSource="{x:Static t3:StepExportDialogViewModel.Schemas}" SelectedIndex="{Binding SchemaIndex}" MinWidth="200"
                      IsEnabled="{Binding !Writing}"/>
        </StackPanel>

        <SelectableTextBlock Text="{Binding Summary}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                             IsVisible="{Binding !Busy}"/>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Busy}" Margin="0,8,0,0">
            <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center"/>
            <SelectableTextBlock Text="{Binding Progress}" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
        <SelectableTextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                             Foreground="{DynamicResource SystemErrorTextColor}" TextWrapping="Wrap" FontSize="12"/>
        <SelectableTextBlock Text="{Binding Notes}" IsVisible="{Binding HasNotes}" TextWrapping="Wrap" FontSize="11" MaxHeight="120"
                             Foreground="{DynamicResource SystemBaseMediumColor}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="Cancel" Width="90" HorizontalContentAlignment="Center" Command="{Binding CancelCommand}"/>
            <Button Content="Export" Width="90" HorizontalContentAlignment="Center" IsDefault="True" Command="{Binding ExportCommand}"
                    ToolTip.Tip="Write the elaborated model to the STEP file. A cancelled export writes nothing."/>
        </StackPanel>
    </StackPanel>
</Window>
