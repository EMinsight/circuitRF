<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v3="using:CircuitRF.Ui.Viewer3D"
             xmlns:t3="using:CircuitRF.Ui.ThreeD"
             xmlns:vv3="using:CircuitRF.Ui.Views.Viewer3D"
             xmlns:s3="using:CircuitRF.Render.Scene3D"
             xmlns:converters="using:CircuitRF.Ui.Converters"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vl="using:CircuitRF.Ui.Views.Layout"
             x:Class="CircuitRF.Ui.Views.ThreeD.C3dEditorView"
             x:DataType="t3:C3dEditorDocument"
             Background="{DynamicResource SystemChromeLowColor}">

    <!-- brief-em3d-43 — the 3D editor: brief 28's pane (one implementation, R-em3d43-1a) drawing the .c3d's
         elaboration, with the document's tree on the left and the selection's Properties on the right.
         Toolbar glyphs are Material icons (kinds verified against Material.Icons 3.0.2 — an unknown kind
         renders nothing, with no error). -->
    <UserControl.Resources>
        <converters:ToLowerStringConverter x:Key="ToLower"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ToggleButton, Button">
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style Selector="TextBox.error">
            <Setter Property="BorderBrush" Value="IndianRed"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- ── Toolbar ─────────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Padding="4,2" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4">
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.IsObjectMode}" ToolTip.Tip="Object mode: select whole solids, sheets and instances  (O)">
                    <mi:MaterialIcon Kind="CubeOutline" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.IsFaceMode}" ToolTip.Tip="Face mode: select one face of a solid or sheet  (F)">
                    <mi:MaterialIcon Kind="VectorSquare" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.IsVertexMode}" ToolTip.Tip="Vertex mode: select one vertex  (V)">
                    <mi:MaterialIcon Kind="VectorPoint" Width="16" Height="16"/>
                </ToggleButton>

                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <Button Command="{Binding ViewModel.Viewer.FitCommand}" ToolTip.Tip="Fit  (Home)">
                    <mi:MaterialIcon Kind="FitToPageOutline" Width="16" Height="16"/>
                </Button>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.IsPerspective}" ToolTip.Tip="Perspective view  (P toggles)">
                    <mi:MaterialIcon Kind="PerspectiveMore" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.IsOrthographic}" ToolTip.Tip="Orthographic view  (P toggles)">
                    <mi:MaterialIcon Kind="PerspectiveLess" Width="16" Height="16"/>
                </ToggleButton>

                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <Button Command="{Binding ViewModel.Viewer.StandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Iso}" ToolTip.Tip="Isometric view  (1)">
                    <mi:MaterialIcon Kind="CubeOutline" Width="16" Height="16"/>
                </Button>
                <Button Command="{Binding ViewModel.Viewer.StandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Top}" ToolTip.Tip="Top view, orthographic  (2)">
                    <v3:Viewer3DViewGlyph Face="Top"/>
                </Button>
                <Button Command="{Binding ViewModel.Viewer.StandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Front}" ToolTip.Tip="Front view, orthographic  (3)">
                    <v3:Viewer3DViewGlyph Face="Front"/>
                </Button>
                <Button Command="{Binding ViewModel.Viewer.StandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Right}" ToolTip.Tip="Right view, orthographic  (4)">
                    <v3:Viewer3DViewGlyph Face="Right"/>
                </Button>
                <Button Command="{Binding ViewModel.Viewer.StandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Back}" ToolTip.Tip="Back view, orthographic  (5)">
                    <v3:Viewer3DViewGlyph Face="Back"/>
                </Button>
                <Button Command="{Binding ViewModel.Viewer.StandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Left}" ToolTip.Tip="Left view, orthographic  (6)">
                    <v3:Viewer3DViewGlyph Face="Left"/>
                </Button>
                <Button Command="{Binding ViewModel.Viewer.StandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Bottom}" ToolTip.Tip="Bottom view, orthographic  (7)">
                    <v3:Viewer3DViewGlyph Face="Bottom"/>
                </Button>

                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <ToggleButton IsChecked="{Binding ViewModel.Viewer.ShowAxisIndicator}" ToolTip.Tip="Axis indicator  (A)">
                    <mi:MaterialIcon Kind="AxisArrow" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.ClipEnabled}" ToolTip.Tip="Clip plane  (C)">
                    <mi:MaterialIcon Kind="ContentCut" Width="16" Height="16"/>
                </ToggleButton>
                <ComboBox ItemsSource="{Binding ViewModel.Viewer.ClipAxes}" SelectedItem="{Binding ViewModel.Viewer.ClipAxis}"
                          IsEnabled="{Binding ViewModel.Viewer.ClipEnabled}" MinWidth="70" VerticalAlignment="Center"
                          ToolTip.Tip="The plane's normal: an axis, or the current view direction"/>
                <Slider Width="120" Minimum="0" Maximum="1" Value="{Binding ViewModel.Viewer.ClipPosition}"
                        IsEnabled="{Binding ViewModel.Viewer.ClipEnabled}" VerticalAlignment="Center"
                        ToolTip.Tip="Drag the clip plane through the model"/>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.ClipFlip}" IsEnabled="{Binding ViewModel.Viewer.ClipEnabled}"
                              ToolTip.Tip="Keep the other side of the plane">
                    <mi:MaterialIcon Kind="SetSplit" Width="16" Height="16"/>
                </ToggleButton>

                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- brief-em3d-44 R-em3d44-5 — snapping: the master switch, then one per kind (each glyph is the
                     marker's), saved per user. Hold Alt / Option to suspend geometry snap; the grid remains. -->
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.SnapEnabled}"
                              ToolTip.Tip="Snap to vertices, midpoints, edges, face centres and the grid. S or F3 turns geometry snap off and on (the grid still applies), F9 the grid — the layout editor's keys. Hold Alt / Option to suspend geometry snap.">
                    <mi:MaterialIcon Kind="Magnet" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.SnapVertex}" IsEnabled="{Binding ViewModel.Viewer.SnapEnabled}" ToolTip.Tip="Snap to vertices">
                    <mi:MaterialIcon Kind="SquareOutline" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.SnapMidpoint}" IsEnabled="{Binding ViewModel.Viewer.SnapEnabled}" ToolTip.Tip="Snap to edge midpoints">
                    <mi:MaterialIcon Kind="TriangleOutline" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.SnapEdge}" IsEnabled="{Binding ViewModel.Viewer.SnapEnabled}" ToolTip.Tip="Snap to the nearest point on an edge">
                    <mi:MaterialIcon Kind="Close" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.SnapFaceCentre}" IsEnabled="{Binding ViewModel.Viewer.SnapEnabled}" ToolTip.Tip="Snap to face centres">
                    <mi:MaterialIcon Kind="CircleOutline" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.SnapGridOn}" IsEnabled="{Binding ViewModel.Viewer.SnapEnabled}" ToolTip.Tip="Snap to the drawing grid when no geometry is in range  (F9)">
                    <mi:MaterialIcon Kind="Grid" Width="16" Height="16"/>
                </ToggleButton>

                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- brief-em3d-45 R-em3d45-1a — the drawing plane and its offset along the normal, in the display unit (a
                     suffix is honoured). Editor state, saved in the workspace's window state. One small combo rather than three
                     buttons (3D editor round 1: fewer toolbar buttons). -->
                <ComboBox MinWidth="58" VerticalAlignment="Center" FontSize="11"
                          ItemsSource="{x:Static t3:C3dEditorViewModel.PlaneChoices}" SelectedItem="{Binding ViewModel.PlaneKind}"
                          ToolTip.Tip="The drawing plane: XY (normal z), YZ (normal x) or XZ (normal y). Ctrl/Cmd-click a face with a tool armed to draw on it."/>
                <TextBox x:Name="PlaneOffsetBox" Width="72" VerticalAlignment="Center" Text="{Binding ViewModel.PlaneOffsetText}"
                         Classes.error="{Binding ViewModel.PlaneOffsetError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         KeyDown="OnPlaneOffsetKey" LostFocus="OnPlaneOffsetLostFocus"
                         ToolTip.Tip="The plane's offset along its normal, in the display unit (25um, 10mil …). Ctrl/Cmd+Shift-click a snapped point to move it there."/>
                <ToggleButton IsChecked="{Binding ViewModel.ShowDrawingGrid}" ToolTip.Tip="The drawing grid on the plane">
                    <mi:MaterialIcon Kind="GridLarge" Width="16" Height="16"/>
                </ToggleButton>

                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- brief-em3d-45 R-em3d45-3 — the tools (Shift+A opens them at the cursor, one letter each). Arming one keeps
                     the selection mode; Esc disarms. Icon kinds verified in Material.Icons 3.0.2: there is no Cylinder
                     kind, so the cylinder is Database (a stack of discs). -->
                <ToggleButton IsChecked="{Binding ViewModel.IsBoxArmed}" ToolTip.Tip="Box: corner, opposite corner, height  (Shift+A, B)">
                    <mi:MaterialIcon Kind="CubeUnfolded" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.IsSheetArmed}" ToolTip.Tip="Sheet: a rectangle, two clicks  (Shift+A, S)">
                    <mi:MaterialIcon Kind="VectorRectangle" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.IsPolygonArmed}" ToolTip.Tip="Polygon: a closed sheet, a click per vertex  (Shift+A, G)">
                    <mi:MaterialIcon Kind="VectorPolygon" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.IsPolylineArmed}" ToolTip.Tip="Polyline: construction geometry, a click per vertex  (Shift+A, L)">
                    <mi:MaterialIcon Kind="VectorPolyline" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.IsCylinderArmed}" ToolTip.Tip="Cylinder: centre, radius, height  (Shift+A, Y)">
                    <mi:MaterialIcon Kind="Database" Width="16" Height="16"/>
                </ToggleButton>
                <!-- brief-em3d-49 R-em3d49-2d — a port, drawn like a sheet; its polarity is inferred from what it touches. -->
                <ToggleButton IsChecked="{Binding ViewModel.IsPortArmed}" ToolTip.Tip="Port: two corners on the drawing plane, between two conductors. The arrow runs from − to +; right-click it to flip  (Shift+A, P)">
                    <mi:MaterialIcon Kind="ArrowUpBoldBoxOutline" Width="16" Height="16"/>
                </ToggleButton>
                <!-- brief-em3d-50 R-em3d50-3 — a bond wire, pad to pad, then its loop height (assembly: lower foot to apex top). -->
                <ToggleButton IsChecked="{Binding ViewModel.IsWireArmed}" ToolTip.Tip="Wire: click the top of one pad, then another (inside an instance too), then set the loop height — measured from the lower foot to the top of the wire — with the mouse or by typing it  (Shift+A, W)">
                    <mi:MaterialIcon Kind="VectorCurve" Width="16" Height="16"/>
                </ToggleButton>
                <ComboBox MinWidth="90" VerticalAlignment="Center" ItemsSource="{Binding ViewModel.MaterialChoices}" SelectedItem="{Binding ViewModel.CurrentMaterial}"
                          IsVisible="{Binding !ViewModel.IsWireArmed}"
                          ToolTip.Tip="The material every new object gets, from the technology's materials"/>
                <!-- brief-em3d-50 R-em3d50-3b — the next wire's values, changeable before the first click. -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding ViewModel.IsWireArmed}">
                    <TextBox Width="64" VerticalAlignment="Center" Text="{Binding ViewModel.WireDiameterText}"
                             Classes.error="{Binding ViewModel.WireDiameterError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             ToolTip.Tip="The wire's diameter, in the display unit (25.4um, 1mil …)"/>
                    <ComboBox MinWidth="80" ItemsSource="{Binding ViewModel.WireMetals}" SelectedItem="{Binding ViewModel.WireMaterial}"
                              ToolTip.Tip="The wire's metal, from the technology's materials with a conductivity"/>
                    <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.BondStyles}" SelectedItem="{Binding ViewModel.WireStartStyle}"
                              ToolTip.Tip="How the start is bonded: a wedge's foot, or a ball"/>
                    <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.BondStyles}" SelectedItem="{Binding ViewModel.WireEndStyle}"
                              ToolTip.Tip="How the end is bonded: a wedge's foot, or a ball"/>
                    <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.WireSections}" SelectedItem="{Binding ViewModel.WireSection}"
                              ToolTip.Tip="The swept section: a flat-bottomed hexagon (a foot lands face to face), or round"/>
                </StackPanel>

                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- brief-em3d-46 R-em3d46-6 — Measure: two snapped points, their deltas and distance; nothing is written. -->
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.IsMeasureArmed}" ToolTip.Tip="Measure: two snapped points — x, y, z, the deltas and the distance, every number copyable  (M)">
                    <mi:MaterialIcon Kind="RulerSquare" Width="16" Height="16"/>
                </ToggleButton>

                <ToggleButton IsChecked="{Binding ViewModel.ShowTree}" ToolTip.Tip="Object tree">
                    <mi:MaterialIcon Kind="FileTreeOutline" Width="16" Height="16"/>
                </ToggleButton>
                <!-- 3D editor round 1 — the selection's fields are in the application's Properties Inspector: this brings it
                     forward, opening it when it was closed. -->
                <Button Command="{Binding ViewModel.ShowPropertiesPanelCommand}" ToolTip.Tip="Properties: bring the Properties Inspector forward (it opens if it was closed)">
                    <mi:MaterialIcon Kind="CardTextOutline" Width="16" Height="16"/>
                </Button>

                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- brief-em3d-49 — the active setup's air box, the setups (Simulate ▸ Setup Analyses…), and Simulate. -->
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.ShowBoundaryFaces}"
                              ToolTip.Tip="Air box: the active setup's, each face tinted by its boundary (PEC grey, PMC orange, symmetry hatched, absorbing clear). In Face mode its faces are picked last; right-click one to set its boundary or padding.">
                    <mi:MaterialIcon Kind="BorderOutside" Width="16" Height="16"/>
                </ToggleButton>
                <Button Command="{Binding ViewModel.OpenSetupAnalysesCommand}" ToolTip.Tip="Setups: the EM setups this 3D view carries, and which one is active (Simulate ▸ Setup Analyses…)">
                    <mi:MaterialIcon Kind="TuneVariant" Width="16" Height="16"/>
                </Button>
                <!-- brief-em3d-51 R-em3d51-4a — the Variables panel. -->
                <ToggleButton IsChecked="{Binding ViewModel.ShowVariables}" ToolTip.Tip="Variables: this 3D view's VARs and its cell's parameters — the names its dimensions may use">
                    <mi:MaterialIcon Kind="Variable" Width="16" Height="16"/>
                </ToggleButton>
                <Button Command="{Binding ViewModel.SimulateActiveCommand}" ToolTip.Tip="Simulate the active setup (Simulate ▸ Run)">
                    <mi:MaterialIcon Kind="PlaylistPlay" Width="16" Height="16"/>
                </Button>

                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- Owner decision D4: the layout editor's Unit control. A document preference, not geometry:
                     it dirties the document and is saved, adds no undo entry, and moves nothing. -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Unit:" VerticalAlignment="Center"/>
                    <ComboBox MinWidth="64" ItemsSource="{x:Static t3:C3dEditorViewModel.AllUnits}"
                              SelectedItem="{Binding ViewModel.DisplayUnit, Mode=TwoWay}"
                              ToolTip.Tip="The unit every length is shown in. Changing it moves nothing.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ToLower}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ── brief-em3d-48: the push-in breadcrumb (hier4's shape); a click pops out to that level ── -->
        <Border DockPanel.Dock="Top" Padding="6,3" BorderThickness="0,0,0,1" IsVisible="{Binding ViewModel.CanPopOut}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Pop Out" FontSize="11" Padding="6,1" Click="OnPopOutClick" ToolTip.Tip="Back to the parent (Ctrl/Cmd+[). A dirty child is saved or discarded as you answer."/>
                <ItemsControl ItemsSource="{Binding ViewModel.Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="t3:C3dBreadcrumb">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="›" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                                <Button Content="{Binding Text}" FontSize="11" Padding="4,1" Tag="{Binding FrameIndex}"
                                        IsEnabled="{Binding !IsCurrent}" Click="OnBreadcrumbClick"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ── brief-em3d-49 R-em3d49-5b: fields over the run's geometry, and the banner when the model moved on ── -->
        <Border DockPanel.Dock="Top" Padding="4,2" BorderThickness="0,0,0,1" IsVisible="{Binding ViewModel.Viewer.FieldsAvailable}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Spacing="2">
                <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4">
                    <ToggleButton IsChecked="{Binding ViewModel.Viewer.ShowField}" ToolTip.Tip="{Binding ViewModel.Viewer.FieldsTip}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <mi:MaterialIcon Kind="Waves" Width="16" Height="16"/>
                            <TextBlock Text="Field" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ComboBox ItemsSource="{Binding ViewModel.Viewer.FieldSolutions}" SelectedItem="{Binding ViewModel.Viewer.SelectedFieldSolution}"
                              IsEnabled="{Binding ViewModel.Viewer.ShowField}" MinWidth="150" VerticalAlignment="Center"
                              ToolTip.Tip="The saved frequency (driven), the mode (eigenmode) or the terminal (static)"/>
                    <ComboBox ItemsSource="{Binding ViewModel.Viewer.FieldQuantities}" SelectedItem="{Binding ViewModel.Viewer.SelectedFieldQuantity}"
                              IsEnabled="{Binding ViewModel.Viewer.ShowField}" MinWidth="170" VerticalAlignment="Center"
                              ToolTip.Tip="What is drawn — only what the solver's files hold is offered">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ToggleButton IsChecked="{Binding ViewModel.Viewer.FieldOnClipPlane}" IsEnabled="{Binding ViewModel.Viewer.ShowField}"
                                  ToolTip.Tip="On the clip plane (turn the plane on with C)">
                        <mi:MaterialIcon Kind="ContentCut" Width="16" Height="16"/>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ViewModel.Viewer.FieldOnSurfaces}" IsEnabled="{Binding ViewModel.Viewer.ShowField}"
                                  ToolTip.Tip="On surfaces: the selected solid's faces, or the conductors for a surface quantity (J_s)">
                        <mi:MaterialIcon Kind="CubeOutline" Width="16" Height="16"/>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ViewModel.Viewer.FieldDb}" IsEnabled="{Binding ViewModel.Viewer.ShowField}" Content="dB"
                                  ToolTip.Tip="Decibels (20·log10 of the amplitude), 40 dB below the top of the range"/>
                    <ToggleButton IsChecked="{Binding ViewModel.Viewer.ShowMesh}" IsEnabled="{Binding ViewModel.Viewer.MeshAvailable}"
                                  ToolTip.Tip="{Binding ViewModel.Viewer.MeshTip}" ToolTip.ShowOnDisabled="True">
                        <mi:MaterialIcon Kind="VectorTriangle" Width="16" Height="16"/>
                    </ToggleButton>
                </WrapPanel>
                <SelectableTextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource CrfWarningBrush}"
                                     Text="{Binding ViewModel.FieldsStaleText}"
                                     IsVisible="{Binding ViewModel.FieldsStaleText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- ── Status ──────────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Padding="6,2" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Spacing="1">
                <DockPanel>
                    <SelectableTextBlock DockPanel.Dock="Right" FontSize="11" Text="{Binding ViewModel.Viewer.CursorText}"/>
                    <SelectableTextBlock DockPanel.Dock="Right" FontSize="11" Margin="0,0,16,0" Text="{Binding ViewModel.GridText}"
                                         IsVisible="{Binding ViewModel.GridText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                         ToolTip.Tip="The drawn grid's minor spacing, and the snap step when it differs (the document's SnapDbu)"/>
                    <SelectableTextBlock DockPanel.Dock="Right" FontSize="11" Margin="0,0,16,0" Text="{Binding ViewModel.PlaneText}"
                                         ToolTip.Tip="The drawing plane"/>
                    <SelectableTextBlock DockPanel.Dock="Right" FontSize="11" Margin="0,0,16,0" Text="{Binding ViewModel.Viewer.SnapText}"
                                         IsVisible="{Binding ViewModel.Viewer.SnapText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                         ToolTip.Tip="What the cursor snaps to, in the display unit. ≈ marks a point that is not an exact database-unit point (a rotated object, or another scale)."/>
                    <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.Viewer.Status}" TextWrapping="Wrap"/>
                </DockPanel>
                <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.Viewer.SelectionText}" TextWrapping="Wrap"
                                     IsVisible="{Binding ViewModel.Viewer.SelectionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.ToolPrompt}" TextWrapping="Wrap"
                                     IsVisible="{Binding ViewModel.ToolPrompt, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <DockPanel IsVisible="{Binding ViewModel.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <!-- brief-em3d-51 R-em3d51-6 — a drag refused on an expression offers the field's number in its place. -->
                    <Button DockPanel.Dock="Right" Content="Replace with Number" FontSize="11" Padding="6,1"
                            Command="{Binding ViewModel.ReplaceWithNumberCommand}" IsVisible="{Binding ViewModel.CanReplaceWithNumber}"/>
                    <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.StatusMessage}" TextWrapping="Wrap"/>
                </DockPanel>
                <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.FrameText}" TextWrapping="Wrap"
                                     IsVisible="{Binding ViewModel.FrameText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.Viewer.LodText}" TextWrapping="Wrap" Foreground="{DynamicResource CrfWarningBrush}"
                                     IsVisible="{Binding ViewModel.Viewer.LodText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.Viewer.Notes}" TextWrapping="Wrap" Opacity="0.85"
                                     IsVisible="{Binding ViewModel.Viewer.Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <!-- ── The object tree (R-em3d43-6a), fed from the document ─────────── -->
            <Border Grid.Column="0" Width="230" IsVisible="{Binding ViewModel.ShowTree}" BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <TreeView x:Name="ObjectTree" ItemsSource="{Binding ViewModel.Tree}"
                          SelectedItem="{Binding ViewModel.SelectedTreeItem, Mode=TwoWay}"
                          ContextRequested="OnTreeContextRequested">
                    <TreeView.Styles>
                        <!-- 3D editor round 1 — expansion is the node's, so it survives the rebuild every edit makes. -->
                        <Style Selector="TreeViewItem" x:DataType="t3:C3dTreeNode">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.DataTemplates>
                        <TreeDataTemplate DataType="t3:C3dTreeGroup" ItemsSource="{Binding Items}">
                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
                        </TreeDataTemplate>
                        <TreeDataTemplate DataType="t3:C3dTreeItem" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <CheckBox IsChecked="{Binding IsVisible}" MinWidth="0" Padding="0"
                                          ToolTip.Tip="Visible — a drawn object's visibility is saved with the document and undoable"/>
                                <TextBlock Text="{Binding OrderText}" Opacity="0.55" FontSize="10" VerticalAlignment="Center"
                                           ToolTip.Tip="Construction order: a later object wins where solids overlap (3D ▸ Modify ▸ Order)"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                <!-- brief-em3d-50 R-em3d50-4 — a wire whose end is on no pad: flagged, with the refusal's words. -->
                                <mi:MaterialIcon Kind="AlertOutline" Width="12" Height="12" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource CrfWarningBrush}"
                                                 IsVisible="{Binding Refusal, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                 ToolTip.Tip="{Binding Refusal}"/>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
            </Border>

            <!-- ── The pane, and its 2D chrome ─────────────────────────────────── -->
            <Panel Grid.Column="1">
                <v3:Viewer3DPane x:Name="Pane" DataContext="{Binding ViewModel.Viewer}"/>
                <v3:Viewer3DOverlay x:Name="Overlay" DataContext="{Binding ViewModel.Viewer}"/>
                <vv3:Viewer3DMeasureCard DataContext="{Binding ViewModel.Viewer}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,104"/>
                <!-- brief-em3d-46 R-em3d46-4b — Array…: a popover, not a modal dialog (no gesture is in progress), with a live
                     preview through per-batch transforms. Accept writes independent copies as one undo entry. -->
                <Border IsVisible="{Binding ViewModel.ArrayOpen}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                        Padding="10,8" CornerRadius="4" BorderThickness="1" Width="300"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Array" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="60,*,4,*,4,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="x" FontSize="11" Opacity="0.7"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="y" FontSize="11" Opacity="0.7"/>
                            <TextBlock Grid.Row="0" Grid.Column="5" Text="z" FontSize="11" Opacity="0.7"/>
                            <TextBlock Grid.Row="1" Text="Count" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ViewModel.ArrayCountX}"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ViewModel.ArrayCountY}"/>
                            <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding ViewModel.ArrayCountZ}"/>
                            <TextBlock Grid.Row="2" Text="Pitch" VerticalAlignment="Center" ToolTip.Tip="In the display unit; a suffix (25um, 10mil) is honoured"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ViewModel.ArrayPitchX}"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ViewModel.ArrayPitchY}"/>
                            <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding ViewModel.ArrayPitchZ}"/>
                        </Grid>
                        <TextBlock Text="{Binding ViewModel.ArrayError}" Foreground="IndianRed" FontSize="11" TextWrapping="Wrap"
                                   IsVisible="{Binding ViewModel.ArrayError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{Binding ViewModel.ArrayNote}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"
                                   IsVisible="{Binding ViewModel.ArrayNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding ViewModel.CloseArrayCommand}"/>
                            <Button Content="Accept" Command="{Binding ViewModel.AcceptArrayCommand}" Classes="accent"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- brief-em3d-45 R-em3d45-4 — the typed field: inline at the cursor, never a dialog. Tab moves between the
                     step's dimensions, Enter accepts the step, Esc returns to the mouse. An entry that does not parse stays,
                     red. The space under it is left for brief 51's Define strip. -->
                <Canvas>
                    <Border Canvas.Left="{Binding ViewModel.FieldX}" Canvas.Top="{Binding ViewModel.FieldY}" IsVisible="{Binding ViewModel.FieldOpen}"
                            Padding="6,4" CornerRadius="4" BorderThickness="1" MinWidth="170"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding ViewModel.FieldLabel}" FontSize="11" Opacity="0.75"/>
                            <TextBox x:Name="FieldInput" Text="{Binding ViewModel.FieldText}" MinWidth="150"
                                     Classes.error="{Binding ViewModel.FieldError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding ViewModel.FieldError}" Foreground="IndianRed" FontSize="11" TextWrapping="Wrap" MaxWidth="260"
                                       IsVisible="{Binding ViewModel.FieldError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <!-- brief-em3d-51 R-em3d51-3b — the live preview: the value in the display unit, or what is unknown. -->
                            <TextBlock Text="{Binding ViewModel.FieldPreview}" FontSize="11" Opacity="0.85" TextWrapping="Wrap" MaxWidth="260"
                                       IsVisible="{Binding ViewModel.FieldPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <!-- brief-em3d-51 R-em3d51-3c — the Define strip: one row per unknown name. Enter defines them all and
                                 takes the step; Esc returns to the field with its text. -->
                            <StackPanel Spacing="3" IsVisible="{Binding ViewModel.DefineOpen}" Margin="0,4,0,0">
                                <TextBlock Text="Define (Enter: define and continue, Esc: back to the field)" FontSize="11" Opacity="0.75"/>
                                <ItemsControl ItemsSource="{Binding ViewModel.DefineRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="t3:C3dDefineRow">
                                            <StackPanel Spacing="2" Margin="0,2">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="40"/>
                                                    <TextBlock Text="=" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding ValueText}" MinWidth="70" KeyDown="OnDefineKey"/>
                                                    <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.DefineUnits}" SelectedItem="{Binding Unit}" MinWidth="60"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <RadioButton Content="VAR in this 3D view" IsChecked="{Binding !AsParameter}" FontSize="11"/>
                                                    <RadioButton Content="Cell parameter" IsChecked="{Binding AsParameter}" IsEnabled="{Binding CanBeParameter}" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Error}" Foreground="IndianRed" FontSize="11" TextWrapping="Wrap"
                                                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ViewModel.DefineError}" Foreground="IndianRed" FontSize="11" TextWrapping="Wrap" MaxWidth="260"
                                           IsVisible="{Binding ViewModel.DefineError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Canvas>
                <SelectableTextBlock x:Name="FaultText" IsVisible="False" TextWrapping="Wrap" Margin="24"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Panel>


            <!-- ── brief-em3d-51 R-em3d51-4a: the Variables panel — the VARs (name, expression, unit, value, link, uses), then the
                 cell's parameters, read-only. Every action is one undo entry. ── -->
            <Border Grid.Column="4" Width="300" IsVisible="{Binding ViewModel.ShowVariables}" BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="8,6">
                <ScrollViewer>
                    <StackPanel Spacing="6" DataContext="{Binding ViewModel.Variables}" x:DataType="t3:C3dVariablesViewModel">
                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="t3:C3dVariableRow">
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="0,4">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ValueText}" Opacity="0.85"/>
                                                <TextBlock Text="{Binding UsesText}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LinkText}" FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                                       IsVisible="{Binding LinkText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <Grid ColumnDefinitions="*,4,70">
                                                <TextBox Grid.Column="0" Text="{Binding EditExpression}" KeyDown="OnVariableKey"
                                                         ToolTip.Tip="The value or expression. A linked VAR's is the cell parameter's default: editing it writes the .ccell."/>
                                                <ComboBox Grid.Column="2" ItemsSource="{x:Static t3:C3dVariablesViewModel.UnitChoices}" SelectedItem="{Binding EditUnit}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Error}" Foreground="IndianRed" FontSize="11" TextWrapping="Wrap"
                                                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4">
                                                <Button Content="Set" FontSize="11" Click="OnVariableSet"/>
                                                <TextBox Text="{Binding EditName}" MinWidth="70" FontSize="11" ToolTip.Tip="A new name; Rename rewrites every reference"/>
                                                <Button Content="Rename" FontSize="11" Click="OnVariableRename"/>
                                                <Button Content="Delete" FontSize="11" Click="OnVariableDelete"/>
                                                <Button Content="Inline" FontSize="11" Click="OnVariableInline" ToolTip.Tip="Write each field's current number in place of this VAR, then delete it"/>
                                                <Button Content="Link" FontSize="11" Click="OnVariableLink" IsVisible="{Binding CanLink}"/>
                                                <Button Content="Unlink" FontSize="11" Click="OnVariableUnlink" IsVisible="{Binding CanUnlink}"/>
                                                <Button Content="Promote to Cell Parameter" FontSize="11" Click="OnVariablePromote" IsVisible="{Binding CanPromote}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Add a VAR" FontSize="11" Opacity="0.7"/>
                        <Grid ColumnDefinitions="70,4,*,4,70">
                            <TextBox Grid.Column="0" Text="{Binding NewName}" Watermark="name"/>
                            <TextBox Grid.Column="2" Text="{Binding NewExpression}" Watermark="value or expression"/>
                            <ComboBox Grid.Column="4" ItemsSource="{x:Static t3:C3dVariablesViewModel.UnitChoices}" SelectedItem="{Binding NewUnit}"/>
                        </Grid>
                        <Button Content="Add" FontSize="11" Click="OnVariableAdd"/>
                        <SelectableTextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                                             IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="Cell parameters (edit them in the cell's parameter editor)" FontSize="11" Opacity="0.7"
                                   IsVisible="{Binding InCell}"/>
                        <ItemsControl ItemsSource="{Binding Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="t3:C3dVariableRow">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Expression}" Opacity="0.8"/>
                                        <TextBlock Text="{Binding Unit}" Opacity="0.8"/>
                                        <TextBlock Text="{Binding ValueText}" Opacity="0.8"/>
                                        <TextBlock Text="{Binding UsesText}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
