<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v3="using:CircuitRF.Ui.Viewer3D"
             xmlns:t3v="using:CircuitRF.Ui.Views.ThreeD"
             x:Class="CircuitRF.Ui.Views.Viewer3D.Viewer3DView"
             x:DataType="v3:Viewer3DDocument">

    <!-- brief-em3d-28 — the 3D view of a .cem. 3D editor bugs round 5: it is the 3D editor's own view, with nothing to
         edit (C3dEditorViewModel.IsViewOnly), so every change to the editor's chrome reaches it; this control only hands
         it the view-only model. The toolbar, tree, fields bar and status pane it used to carry are gone. -->
    <t3v:C3dEditorView DataContext="{Binding Editor}"/>
</UserControl>
