<!-- The picture source (brief-img-5-dialog.md R-im5-2, R-im5-4, R-im5-6): the picture, what kind of drawing it is, what
     to make of it, and — for a layout picture — the technology and the scale. Values only; each control says what it
     does in its tooltip. The highlighted slot is the one control the reading is waiting for. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:CircuitRF.Ui.Recognition"
             xmlns:ctrl="using:CircuitRF.Ui.Controls"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="CircuitRF.Ui.Recognition.ImageSourcePane"
             x:DataType="rec:ImageSourceViewModel">
    <StackPanel Spacing="6">
        <!-- ── Source row · Read as · Make ─────────────────────────────────────────────────── -->
        <WrapPanel Classes="row" Orientation="Horizontal">
            <Border Width="44" Height="44" Margin="0,0,10,0" BorderThickness="1" CornerRadius="3" ClipToBounds="True"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Background="White">
                <Image x:Name="Thumbnail" Stretch="Uniform"/>
            </Border>
            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center" MinWidth="140" MaxWidth="260">
                <SelectableTextBlock Text="{Binding SourceName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding SourceName}"/>
                <SelectableTextBlock Text="{Binding SizeText}" FontSize="11" Opacity="0.7"/>
            </StackPanel>
            <!-- Toolbar-style, as the editors' toolbars are (brief-ptu-2 R-ptu2-1): a glyph, its name first in the tooltip. -->
            <StackPanel Classes="Toolbar" Orientation="Horizontal" Spacing="2">
                <Button Command="{Binding BrowseCommand}" Padding="6,3"
                        ToolTip.Tip="Replace — read another picture instead of this one.">
                    <mi:MaterialIcon Kind="FileReplaceOutline" Width="16" Height="16"/>
                </Button>
                <Button Command="{Binding PasteCommand}" Padding="6,3"
                        ToolTip.Tip="Paste — read the picture on the clipboard instead (Cmd/Ctrl+V).">
                    <mi:MaterialIcon Kind="ContentPaste" Width="16" Height="16"/>
                </Button>
            </StackPanel>
            <Border Classes="sep"/>

            <TextBlock Classes="label" Text="Read as" Margin="0,0,6,0"/>
            <StackPanel Classes="Toolbar" Orientation="Horizontal" Spacing="2">
                <RadioButton Classes="tool" Theme="{StaticResource {x:Type ToggleButton}}"
                             IsChecked="{Binding IsAutoKind}">
                    <ToolTip.Tip>
                        <MultiBinding StringFormat="{}{0} — {1}">
                            <Binding Path="AutoLabel"/>
                            <Binding Path="AutoTip"/>
                        </MultiBinding>
                    </ToolTip.Tip>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="AutoFix" Width="16" Height="16"/>
                        <Ellipse Width="8" Height="8" Fill="{Binding AutoConfidenceBrush}" IsVisible="{Binding HasReadKind}"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Classes="tool" Theme="{StaticResource {x:Type ToggleButton}}"
                             IsChecked="{Binding IsSchematicKind}"
                             ToolTip.Tip="Schematic — read the picture as a schematic drawing, whatever it looks like.">
                    <mi:MaterialIcon Kind="ResistorNodes" Width="16" Height="16"/>
                </RadioButton>
                <RadioButton Classes="tool" Theme="{StaticResource {x:Type ToggleButton}}"
                             IsChecked="{Binding IsLayoutKind}"
                             ToolTip.Tip="Layout — read the picture as a layout: coloured copper, pads and holes.">
                    <ctrl:ImageMakeGlyphControl Kind="Layout" Width="16" Height="16"/>
                </RadioButton>
                <RadioButton Classes="tool" Theme="{StaticResource {x:Type ToggleButton}}"
                             IsChecked="{Binding IsPlotKind}"
                             ToolTip.Tip="Plot — read the picture as a plot: a rectangular plot against frequency, a Smith chart or a polar chart, digitised trace by trace.">
                    <mi:MaterialIcon Kind="ChartLine" Width="16" Height="16"/>
                </RadioButton>
            </StackPanel>
            <Border Classes="sep"/>

            <TextBlock Classes="label" Text="Make" Margin="0,0,6,0"/>
            <StackPanel Classes="Toolbar" Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsDrawingPicture}">
                <RadioButton Classes="tool" Theme="{StaticResource {x:Type ToggleButton}}"
                             IsChecked="{Binding IsMakeSchematic}" IsEnabled="{Binding MakeSchematicEnabled}"
                             ToolTip.Tip="{Binding MakeSchematicTip}" ToolTip.ShowOnDisabled="True">
                    <mi:MaterialIcon Kind="ResistorNodes" Width="16" Height="16"/>
                </RadioButton>
                <RadioButton Classes="tool" Theme="{StaticResource {x:Type ToggleButton}}"
                             IsChecked="{Binding IsMakeLayout}" IsEnabled="{Binding MakeLayoutEnabled}"
                             ToolTip.Tip="{Binding MakeLayoutTip, StringFormat='Layout — {0}'}" ToolTip.ShowOnDisabled="True">
                    <ctrl:ImageMakeGlyphControl Kind="Layout" Width="16" Height="16"/>
                </RadioButton>
            </StackPanel>
            <StackPanel Classes="Toolbar" Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsPlotPicture}">
                <RadioButton Classes="tool" Theme="{StaticResource {x:Type ToggleButton}}"
                             IsChecked="{Binding IsMakeTouchstone}"
                             ToolTip.Tip="Touchstone — a Touchstone file of every entry the traces describe, each missing phase and entry filled by the rule the matrix grid shows.">
                    <ctrl:ImageMakeGlyphControl Kind="Touchstone" Width="16" Height="16"/>
                </RadioButton>
                <RadioButton Classes="tool" Theme="{StaticResource {x:Type ToggleButton}}"
                             IsChecked="{Binding IsMakeCsv}"
                             ToolTip.Tip="CSV — the raw digitised traces, in each plot's own units, never resampled. Any plot digitises, S-parameters or not.">
                    <mi:MaterialIcon Kind="FileDelimitedOutline" Width="16" Height="16"/>
                </RadioButton>
            </StackPanel>
        </WrapPanel>

        <!-- ── A plot session's pictures (brief-img-14 R-im14-12) ────────────────────────── -->
        <WrapPanel Classes="row" Orientation="Horizontal" IsVisible="{Binding IsPlotPicture}">
            <!-- Read: Automatic | Manual (brief-pdg-4 R-pdg4-5): the frame found and the labels read, or the box and the
                 scale typed by hand. Switching keeps the picture. -->
            <TextBlock Classes="label" Text="Read" Width="70" Margin="0,0,6,0"/>
            <StackPanel Classes="Toolbar" Orientation="Horizontal" Spacing="2" Margin="0,0,18,0">
                <RadioButton Classes="tool" Theme="{StaticResource {x:Type ToggleButton}}" Content="Automatic" FontSize="12"
                             IsChecked="{Binding Plots.IsAutomatic}"
                             ToolTip.Tip="Automatic — the plots are found, their tick labels read and their curves traced; correct what was read."/>
                <RadioButton Classes="tool" Theme="{StaticResource {x:Type ToggleButton}}" Content="Manual" FontSize="12"
                             IsChecked="{Binding Plots.IsManual}"
                             ToolTip.Tip="Manual — draw the plot area, type its scale and place each curve's points (or find a curve from one click). No text in the picture is read."/>
            </StackPanel>
        </WrapPanel>
        <WrapPanel Classes="row" Orientation="Horizontal" IsVisible="{Binding IsPlotPicture}">
            <TextBlock Classes="label" Text="Pictures" Width="70" Margin="0,0,6,0"/>
            <ItemsControl ItemsSource="{Binding Plots.Pictures}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="rec:PlotPictureRowViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,10,0">
                            <Button Classes="link" Content="{Binding Label}" Command="{Binding ShowCommand}"
                                    ToolTip.Tip="Show this picture on the canvas."/>
                            <Button Classes="link" Content="✕" Command="{Binding RemoveCommand}" IsVisible="{Binding Removable}"
                                    ToolTip.Tip="Take this picture out of the session."/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Classes="Toolbar" Orientation="Horizontal" Margin="0,0,18,0">
                <Button Command="{Binding AddPictureCommand}" Padding="6,3"
                        ToolTip.Tip="Add picture — another picture into the same session: an S11 chart beside the S21 plot make one file. Dropping or pasting one does the same.">
                    <mi:MaterialIcon Kind="FileImagePlusOutline" Width="16" Height="16"/>
                </Button>
            </StackPanel>
            <TextBlock Classes="label" Text="Smith Z0" Margin="0,0,6,0" IsVisible="{Binding Plots.HasSmith}"/>
            <TextBox Text="{Binding Plots.SmithZ0Text}" Width="80" PlaceholderText="50 Ω" Margin="0,0,18,0"
                     IsVisible="{Binding Plots.HasSmith}"
                     ToolTip.Tip="A Smith chart's reference impedance. The chart's own Z0 = word when one is read, else 50 Ω — said in the report."/>
            <CheckBox Content="Keep the source pictures beside the file" IsChecked="{Binding Plots.KeepSources}"
                      IsVisible="{Binding MakeTouchstone}"
                      ToolTip.Tip="Each picture is copied beside the Touchstone as &lt;name&gt;.source.png, so the file can be checked against what it was read from."/>
        </WrapPanel>

        <!-- ── Technology · Scale (a layout picture) ─────────────────────────────────────── -->
        <WrapPanel Classes="row" Orientation="Horizontal" IsVisible="{Binding IsLayoutPicture}">
            <TextBlock Classes="label" Text="Technology" Width="70" Margin="0,0,6,0"/>
            <Border Classes="slot" Classes.wants="{Binding HighlightTechnology}" Margin="0,0,18,0">
                <ComboBox ItemsSource="{Binding TechnologyChoices}" SelectedIndex="{Binding TechnologyIndex}" MinWidth="200"
                          PlaceholderText="No technology"
                          ToolTip.Tip="The layers the picture is traced onto and the stackup the circuit is read with. A picture says nothing about the stackup."/>
            </Border>

            <TextBlock Classes="label" Text="Scale" Margin="0,0,6,0"/>
            <Border Classes="slot" Classes.wants="{Binding Scale.NeedsScale}">
                <StackPanel Classes="row" Orientation="Horizontal" Spacing="8">
                    <SelectableTextBlock Text="{Binding Scale.ValueText}" FontWeight="SemiBold" FontSize="12" MinWidth="70"
                                         VerticalAlignment="Center" ToolTip.Tip="How long one pixel of the picture is."/>
                    <ComboBox ItemsSource="{Binding Scale.Choices}" SelectedItem="{Binding Scale.SelectedChoice}" MinWidth="250"
                              PlaceholderText="Choose the evidence…"
                              ToolTip.Tip="What the scale is taken from. Two points…: click two points and type the distance between them. Line impedance…: click a trace and type its Z0."/>
                    <SelectableTextBlock Text="{Binding Scale.ResolutionLine}" FontSize="11" Opacity="0.75" VerticalAlignment="Center"/>
                    <SelectableTextBlock Text="{Binding Scale.Error}" Classes="error" MaxWidth="420"
                                         IsVisible="{Binding Scale.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Border>
        </WrapPanel>
    </StackPanel>
</UserControl>
