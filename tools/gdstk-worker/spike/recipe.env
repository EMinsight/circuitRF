# gdstk, qhull and zlib for circuitRF's gdstk worker -- THE SPIKE'S RECIPE, AS DATA (brief-oasis-gdstk.md
# §3 Q1). G1 moves this to tools/gdstk-worker/recipe.env. READ, never sourced (the geometry worker's rule):
# one KEY=value per line, no quotes, no spaces around '='.
#
# Upstream publishes no SHA-256 for any of these archives (zlib publishes a detached .asc signature);
# each value below was computed by this spike from the archive it downloaded and built.

GDSTK_VERSION=1.0.1
GDSTK_URL=https://github.com/heitzmann/gdstk/archive/refs/tags/v1.0.1.tar.gz
GDSTK_ARCHIVE=gdstk-1.0.1.tar.gz
GDSTK_SHA256=7819120177050db4ef8bd3394158c7cecc4555640d50f634f957eafdcbcd7984
GDSTK_SOURCE_DIR=gdstk-1.0.1

# qhull 2020.2 is qhull_r 8.0.2, the version gdstk's find_package(Qhull 8) asks for. Only the reentrant
# static library (qhullstatic_r) is built; gdstk calls it from one function (src/utils.cpp, convex_hull).
QHULL_VERSION=2020.2
QHULL_URL=https://github.com/qhull/qhull/archive/refs/tags/2020.2.tar.gz
QHULL_ARCHIVE=qhull-2020.2.tar.gz
QHULL_SHA256=59356b229b768e6e2b09a701448bfa222c37b797a84f87f864f97462d8dbc7c5
QHULL_SOURCE_DIR=qhull-2020.2
# qhull's CMakeLists.txt declares cmake_minimum_required(VERSION 3.0); CMake 4 refuses below 3.5 unless told.
QHULL_CMAKE_OPTIONS=-DBUILD_SHARED_LIBS=OFF -DBUILD_STATIC_LIBS=ON -DCMAKE_POLICY_VERSION_MINIMUM=3.5

ZLIB_VERSION=1.3.2
ZLIB_URL=https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz
ZLIB_ARCHIVE=zlib-1.3.2.tar.gz
ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
ZLIB_SOURCE_DIR=zlib-1.3.2
ZLIB_CMAKE_OPTIONS=-DZLIB_BUILD_SHARED=OFF -DZLIB_BUILD_STATIC=ON -DZLIB_BUILD_TESTING=OFF

# circuitRF's LSMinimumSystemVersion.
OSX_DEPLOYMENT_TARGET=13.0

# The Windows cross-compiler, as the geometry worker's RESOLVED.md records it.
LLVM_MINGW_VERSION=20260922
