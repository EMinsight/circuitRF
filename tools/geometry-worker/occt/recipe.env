# OpenCASCADE Technology for circuitRF's geometry worker -- THE RECIPE, AS DATA (brief-em3d-62 R-em3d62-3a).
#
# Every value is copied from docs/design/em-3d-f4b-spike-findings.md, "The recipe" (brief 61). Adopting
# a new OCCT is an edit here, a rebuild (tools/geometry-worker/build.sh) and the worker's `selftest` --
# nothing else in the repository names a version. RECIPE.md beside this file is the human copy.
#
# FORMAT: one KEY=value per line, no quotes, no spaces around '='. This file is READ, never sourced or
# `call`ed: build.sh, build.cmd and the ensure-built scripts parse it line by line, so a value may hold
# spaces and ';' (the CMake options do) and '$ORIGIN' stays literal.

OCCT_VERSION=8.0.1
OCCT_TAG=V8_0_1
OCCT_URL=https://github.com/Open-Cascade-SAS/OCCT/archive/refs/tags/V8_0_1.tar.gz
# Upstream publishes no checksum for its source; this is the archive brief 61 downloaded, built and
# re-downloaded (the clean copy-and-paste check), and the archive the written offer refers to.
OCCT_SHA256=0d6913eae4bcc09a3653ceced6dda1aec11c35a1513d4c06762c9b002092c68a
# The directory the archive unpacks to.
OCCT_SOURCE_DIR=OCCT-8_0_1

# Every module off, the seven leaf toolkits named (25 are built), every optional product off. Build
# type, install prefix and generator are supplied by the build scripts, per machine.
OCCT_CMAKE_OPTIONS=-DBUILD_LIBRARY_TYPE=Shared -DBUILD_MODULE_FoundationClasses=OFF -DBUILD_MODULE_ModelingData=OFF -DBUILD_MODULE_ModelingAlgorithms=OFF -DBUILD_MODULE_Visualization=OFF -DBUILD_MODULE_ApplicationFramework=OFF -DBUILD_MODULE_DataExchange=OFF -DBUILD_MODULE_Draw=OFF -DBUILD_ADDITIONAL_TOOLKITS=TKBO;TKFillet;TKShHealing;TKMesh;TKPrim;TKDESTEP;TKXCAF -DUSE_FREETYPE=OFF -DUSE_OPENGL=OFF -DUSE_GLES2=OFF -DUSE_TK=OFF -DUSE_TCL=OFF -DUSE_XLIB=OFF -DUSE_TBB=OFF -DUSE_RAPIDJSON=OFF -DUSE_DRACO=OFF -DUSE_VTK=OFF -DUSE_FREEIMAGE=OFF -DUSE_FFMPEG=OFF -DUSE_OPENVR=OFF -DUSE_EIGEN=OFF -DBUILD_DOC_Overview=OFF -DBUILD_GTEST=OFF -DBUILD_USE_PCH=OFF

# The per-RID line. macOS adds CMAKE_OSX_ARCHITECTURES itself (arm64 or x86_64); 13.0 is circuitRF's
# LSMinimumSystemVersion.
OCCT_CMAKE_OPTIONS_OSX=-DCMAKE_OSX_DEPLOYMENT_TARGET=13.0
# Linux: each library finds its siblings beside itself. NOT in brief 61's macOS-verified line -- on
# macOS the libraries bind each other by @rpath and inherit the worker's own run path, but an ELF's
# DT_RUNPATH covers only that object's OWN dependencies, so without this TKBO would look for TKG2d
# everywhere except the folder it sits in. A CMake option, not a patch. See RECIPE.md.
OCCT_CMAKE_OPTIONS_LINUX=-DCMAKE_INSTALL_RPATH=$ORIGIN
# Windows: build.cmd adds -G "Visual Studio 17 2022" -A x64|ARM64|Win32 and builds --config Release.
OCCT_CMAKE_OPTIONS_WINDOWS=

# D2 -- the RIDs whose installers SHIP the kernel. A packaging script fails when one of these lacks it
# (CRF_ALLOW_NO_KERNEL=1 overrides). win-x86 is out until brief 61's Q13 is answered; its installer
# notes carry the sentence in RECIPE.md. Brief 61: "no RID on the strength of a build alone".
KERNEL_RIDS=osx-arm64 osx-x64 linux-x64 linux-arm64 win-x64 win-arm64
