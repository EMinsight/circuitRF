<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UiSnapshot — hosts circuitRF's REAL Avalonia views in a headless window and writes a PNG of what they
    paint, so a UI change can be looked at from a shell that cannot open the GUI. Not part of the application
    and NOT in circuitRF.slnx, so a plain `dotnet build` neither builds it nor restores Avalonia.Headless.
    Usage and the traps are in README.md beside this file.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ui\CircuitRF.Ui.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.0.3" />
  </ItemGroup>

</Project>
