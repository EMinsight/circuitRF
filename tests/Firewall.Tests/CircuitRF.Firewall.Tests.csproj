<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project references cause the DLLs to be copied to the test output, which is what the
         reference-inspecting tests read. Since brief-automation-2 one test also CALLS into
         CircuitRF.Design (SchematicChainBelowTheFirewallTests runs the .csch → .cnl chain here
         precisely because this project cannot reach src/Ui) — so this list is now load-bearing in
         two ways, and src/Ui must never appear in it. -->
    <ProjectReference Include="../../src/Diagnostics/CircuitRF.Diagnostics.csproj" />
    <ProjectReference Include="../../src/RfCore/RfCore.csproj" />
    <ProjectReference Include="../../src/Core/CircuitRF.Core.csproj" />
    <ProjectReference Include="../../src/Engine/CircuitRF.Engine.csproj" />
    <ProjectReference Include="../../src/Design/CircuitRF.Design.csproj" />
    <ProjectReference Include="../../src/Cli/CircuitRF.Cli.csproj" />
    <ProjectReference Include="../../src/Harmonica/CircuitRF.Harmonica.csproj" />
    <ProjectReference Include="../../src/WBond/CircuitRF.WBond.csproj" />
    <ProjectReference Include="../../src/Thermal/CircuitRF.Thermal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pins this assembly to en-US before any test runs, so assertions stop depending on the
         runner's OS locale (brief-localization-groundwork.md R-loc-4). Shared by all seven test
         projects; see tests/TestCulture.cs for why it is a ModuleInitializer. -->
    <Compile Include="../TestCulture.cs" Link="TestCulture.cs" />
  </ItemGroup>

</Project>
