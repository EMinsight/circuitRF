      h2_8_T = (1.0 - h2_8*h2_8)*(0.45251468136989453*h1_1_T + 0.6003268764457097*h1_2_T + 0.1727805887167078*h1_3_T + 0.08113203378795272*h1_4_T + 0.26253999795299554*h1_5_T - 0.31804582738721754*h1_6_T - 1.1885448737246078*h1_7_T + 1.3643024505925228*h1_8_T);
      // output
      u = -0.1352683009856447 - 0.14958672307798132*h2_1 + 0.5660095555065648*h2_2 - 0.6499896945736368*h2_3 + 1.8323156404733003*h2_4 - 0.4593989494528838*h2_5 - 2.131315306286907*h2_6 + 1.260210161127013*h2_7 + 1.622721543090151*h2_8;
      u_vgs = - 0.14958672307798132*h2_1_vgs + 0.5660095555065648*h2_2_vgs - 0.6499896945736368*h2_3_vgs + 1.8323156404733003*h2_4_vgs - 0.4593989494528838*h2_5_vgs - 2.131315306286907*h2_6_vgs + 1.260210161127013*h2_7_vgs + 1.622721543090151*h2_8_vgs;
      u_vds = - 0.14958672307798132*h2_1_vds + 0.5660095555065648*h2_2_vds - 0.6499896945736368*h2_3_vds + 1.8323156404733003*h2_4_vds - 0.4593989494528838*h2_5_vds - 2.131315306286907*h2_6_vds + 1.260210161127013*h2_7_vds + 1.622721543090151*h2_8_vds;
      u_T = - 0.14958672307798132*h2_1_T + 0.5660095555065648*h2_2_T - 0.6499896945736368*h2_3_T + 1.8323156404733003*h2_4_T - 0.4593989494528838*h2_5_T - 2.131315306286907*h2_6_T + 1.260210161127013*h2_7_T + 1.622721543090151*h2_8_T;
      f_Qd = 0.0 + 1.0700932823311475e-12*u;
      d_vgs = 1.0700932823311475e-12*u_vgs;
      d_vds = 1.0700932823311475e-12*u_vds;
      d_T = 1.0700932823311475e-12*u_T;
    end
  endfunction

  // Core.Constituents.Qd.Network continued outside Core.Constituents.Qd.Domain (guided extrapolation)
  analog function real x_Qd;
    input vgs, vds, T;
    real vgs, vds, T;
    real u_vgs, u_vds, u_T, b_vgs, b_vds, b_T, p_vgs, p_vds, p_T, g_vgs, g_vds, g_T;
    real t, cx, cy, e, best, cr, fb, s, dist2;
    integer inside, inbox;
    begin
      // normalised by the domain's centre and extent
      u_vgs = (vgs - (-0.9208796670951123))/2.1582407449889756;
      u_vds = (vds - 7.566235437630191)/14.867529124463616;
      u_T = (T - 64.251518025185)/78.50303605037001;
      inbox = 1;
      // Domain.Box.T
      if (u_T < (-0.5)) begin b_T = (-0.5); inbox = 0; end
      else if (u_T > 0.5) begin b_T = 0.5; inbox = 0; end
      else b_T = u_T;
      // Domain.Polygon: 10 vertices, counter-clockwise
      inside = 1;
      cr = 0.9945485555180813*(u_vds - (-0.47527975047364995)) - (-0.024720249526350158)*(u_vgs - (-0.5));
      if (cr < 0.0) inside = 0;
      cr = 0.005451444481918644*(u_vds - (-0.5000000000000001)) - 0.0018944617201674951*(u_vgs - 0.49454855551808136);
      if (cr < 0.0) inside = 0;
      cr = (-0.09398705129148938)*(u_vds - (-0.4981055382798326)) - 0.9426177824000829*(u_vgs - 0.5);
      if (cr < 0.0) inside = 0;
      cr = (-0.09249964651191961)*(u_vds - 0.44451224412025026) - 0.016160326304840433*(u_vgs - 0.4060129487085106);
      if (cr < 0.0) inside = 0;
      cr = (-0.13091432540818732)*(u_vds - 0.4606725704250907) - 0.01891242532930726*(u_vgs - 0.313513302196591);
      if (cr < 0.0) inside = 0;
      cr = (-0.14509413109986158)*(u_vds - 0.47958499575439795) - 0.013984722374358438*(u_vgs - 0.1825989767884037);
      if (cr < 0.0) inside = 0;
      cr = (-0.16824602428679386)*(u_vds - 0.4935697181287564) - 0.005939079510797307*(u_vgs - 0.037504845688542135);
      if (cr < 0.0) inside = 0;
      cr = (-0.18393634886175214)*(u_vds - 0.4995087976395537) - 0.00048644775735068313*(u_vgs - (-0.13074117859825174));
      if (cr < 0.0) inside = 0;
      cr = (-0.1853224541917186)*(u_vds - 0.4999952453969044) - 4.754603095624699e-06*(u_vgs - (-0.3146775274600039));
      if (cr < 0.0) inside = 0;
      cr = (-1.834827750846202e-08)*(u_vds - 0.5) - (-0.9752797504736499)*(u_vgs - (-0.4999999816517225));
      if (cr < 0.0) inside = 0;
      if (inside) begin
        b_vgs = u_vgs;
        b_vds = u_vds;
      end else begin
        t = ((u_vgs - (-0.5))*0.9945485555180813 + (u_vds - (-0.47527975047364995))*(-0.024720249526350158))/0.989737920019747;
        if (t < 0.0) t = 0.0; else if (t > 1.0) t = 1.0;
        cx = (-0.5) + t*0.9945485555180813;
        cy = (-0.47527975047364995) + t*(-0.024720249526350158);
        e = (u_vgs - cx)*(u_vgs - cx) + (u_vds - cy)*(u_vds - cy);
        best = e; b_vgs = cx; b_vds = cy;
        t = ((u_vgs - 0.49454855551808136)*0.005451444481918644 + (u_vds - (-0.5000000000000001))*0.0018944617201674951)/3.3307232148621213e-05;
        if (t < 0.0) t = 0.0; else if (t > 1.0) t = 1.0;
        cx = 0.49454855551808136 + t*0.005451444481918644;
        cy = (-0.5000000000000001) + t*0.0018944617201674951;
        e = (u_vgs - cx)*(u_vgs - cx) + (u_vds - cy)*(u_vds - cy);
        if (e < best) begin best = e; b_vgs = cx; b_vds = cy; end
        t = ((u_vgs - 0.5)*(-0.09398705129148938) + (u_vds - (-0.4981055382798326))*0.9426177824000829)/0.897361849507319;
        if (t < 0.0) t = 0.0; else if (t > 1.0) t = 1.0;
        cx = 0.5 + t*(-0.09398705129148938);
        cy = (-0.4981055382798326) + t*0.9426177824000829;
        e = (u_vgs - cx)*(u_vgs - cx) + (u_vds - cy)*(u_vds - cy);
        if (e < best) begin best = e; b_vgs = cx; b_vds = cy; end
        t = ((u_vgs - 0.4060129487085106)*(-0.09249964651191961) + (u_vds - 0.44451224412025026)*0.016160326304840433)/0.008817340751109;
        if (t < 0.0) t = 0.0; else if (t > 1.0) t = 1.0;
        cx = 0.4060129487085106 + t*(-0.09249964651191961);
        cy = 0.44451224412025026 + t*0.016160326304840433;
        e = (u_vgs - cx)*(u_vgs - cx) + (u_vds - cy)*(u_vds - cy);
        if (e < best) begin best = e; b_vgs = cx; b_vds = cy; end
        t = ((u_vgs - 0.313513302196591)*(-0.13091432540818732) + (u_vds - 0.4606725704250907)*0.01891242532930726)/0.017496240428917384;
        if (t < 0.0) t = 0.0; else if (t > 1.0) t = 1.0;
        cx = 0.313513302196591 + t*(-0.13091432540818732);
        cy = 0.4606725704250907 + t*0.01891242532930726;
        e = (u_vgs - cx)*(u_vgs - cx) + (u_vds - cy)*(u_vds - cy);
        if (e < best) begin best = e; b_vgs = cx; b_vds = cy; end
        t = ((u_vgs - 0.1825989767884037)*(-0.14509413109986158) + (u_vds - 0.47958499575439795)*0.013984722374358438)/0.0212478793395117;
        if (t < 0.0) t = 0.0; else if (t > 1.0) t = 1.0;
        cx = 0.1825989767884037 + t*(-0.14509413109986158);
        cy = 0.47958499575439795 + t*0.013984722374358438;
        e = (u_vgs - cx)*(u_vgs - cx) + (u_vds - cy)*(u_vds - cy);
        if (e < best) begin best = e; b_vgs = cx; b_vds = cy; end
        t = ((u_vgs - 0.037504845688542135)*(-0.16824602428679386) + (u_vds - 0.4935697181287564)*0.005939079510797307)/0.028341997353748004;
        if (t < 0.0) t = 0.0; else if (t > 1.0) t = 1.0;
        cx = 0.037504845688542135 + t*(-0.16824602428679386);
        cy = 0.4935697181287564 + t*0.005939079510797307;
        e = (u_vgs - cx)*(u_vgs - cx) + (u_vds - cy)*(u_vds - cy);
        if (e < best) begin best = e; b_vgs = cx; b_vds = cy; end
        t = ((u_vgs - (-0.13074117859825174))*(-0.18393634886175214) + (u_vds - 0.4995087976395537)*0.00048644775735068313)/0.03383281706401282;
        if (t < 0.0) t = 0.0; else if (t > 1.0) t = 1.0;
        cx = (-0.13074117859825174) + t*(-0.18393634886175214);
        cy = 0.4995087976395537 + t*0.00048644775735068313;
        e = (u_vgs - cx)*(u_vgs - cx) + (u_vds - cy)*(u_vds - cy);
        if (e < best) begin best = e; b_vgs = cx; b_vds = cy; end
        t = ((u_vgs - (-0.3146775274600039))*(-0.1853224541917186) + (u_vds - 0.4999952453969044)*4.754603095624699e-06)/0.034344412050247894;
        if (t < 0.0) t = 0.0; else if (t > 1.0) t = 1.0;
        cx = (-0.3146775274600039) + t*(-0.1853224541917186);
        cy = 0.4999952453969044 + t*4.754603095624699e-06;
        e = (u_vgs - cx)*(u_vgs - cx) + (u_vds - cy)*(u_vds - cy);
        if (e < best) begin best = e; b_vgs = cx; b_vds = cy; end
        t = ((u_vgs - (-0.4999999816517225))*(-1.834827750846202e-08) + (u_vds - 0.5)*(-0.9752797504736499))/0.9511705916839451;
        if (t < 0.0) t = 0.0; else if (t > 1.0) t = 1.0;
        cx = (-0.4999999816517225) + t*(-1.834827750846202e-08);
        cy = 0.5 + t*(-0.9752797504736499);
        e = (u_vgs - cx)*(u_vgs - cx) + (u_vds - cy)*(u_vds - cy);
        if (e < best) begin best = e; b_vgs = cx; b_vds = cy; end
      end
      // the nearest domain point: the point itself inside, else back from normalised coordinates
      if (inside && inbox) begin
        p_vgs = vgs;
        p_vds = vds;
        p_T = T;
      end else begin
        p_vgs = (-0.9208796670951123) + 2.1582407449889756*b_vgs;
        p_vds = 7.566235437630191 + 14.867529124463616*b_vds;
        p_T = 64.251518025185 + 78.50303605037001*b_T;
      end
      fb = f_Qd(p_vgs, p_vds, p_T, g_vgs, g_vds, g_T);
      x_Qd = fb + g_vgs*(vgs - p_vgs) + g_vds*(vds - p_vds) + g_T*(T - p_T);
    end
  endfunction

  // Traps (CaptureEmission) drain-lag phi2: emission towards vds, capture upwards; dphi/dt in V/s
  analog function real r_phi2;
    input ph, vgs, vds, T;
    real ph, vgs, vds, T;
    real x, u, ex, f, re, tk, tr;
    begin
      x = vds - ph;
      u = (x - Xref)/Vc;
      if (u <= 20.0) ex = exp(u);
      else ex = exp(20.0)*(1.0 + (u - 20.0));
      f = (Xref/TauCapt2)*(ex - exp(-Xref/Vc));
      re = 1.0/TauEmit2;
      r_phi2 = (vds - ph)*re + f;
    end
  endfunction

  // Traps (CaptureEmission) phi2's DC value: vds
  analog function real dc_phi2;
    input vgs, vds, T;
    real vgs, vds, T;
    begin
      dc_phi2 = vds;
    end
  endfunction

  // Core.Constituents.Qg.Network with its Hessian along a direction
  analog function real fh_Qg;
    input vgs, vds, T, w_vgs, w_vds, w_T;
    output d_vgs, d_vds, d_T, hw_vgs, hw_vds, hw_T;
    real vgs, vds, T, w_vgs, w_vds, w_T;
    real d_vgs, d_vds, d_T, hw_vgs, hw_vds, hw_T;
    real z, zw, sl, slw, zg_vgs, zgw_vgs, zg_vds, zgw_vds, zg_T, zgw_T, x1, x1_w;
    real x2, x2_w, x3, x3_w, h1_1, h1_1_w, h1_1_vgs, h1_1_vgs_w, h1_1_vds, h1_1_vds_w, h1_1_T, h1_1_T_w;
    real h1_2, h1_2_w, h1_2_vgs, h1_2_vgs_w, h1_2_vds, h1_2_vds_w, h1_2_T, h1_2_T_w, h1_3, h1_3_w, h1_3_vgs, h1_3_vgs_w;
    real h1_3_vds, h1_3_vds_w, h1_3_T, h1_3_T_w, h1_4, h1_4_w, h1_4_vgs, h1_4_vgs_w, h1_4_vds, h1_4_vds_w, h1_4_T, h1_4_T_w;
    real h1_5, h1_5_w, h1_5_vgs, h1_5_vgs_w, h1_5_vds, h1_5_vds_w, h1_5_T, h1_5_T_w, h1_6, h1_6_w, h1_6_vgs, h1_6_vgs_w;
    real h1_6_vds, h1_6_vds_w, h1_6_T, h1_6_T_w, h1_7, h1_7_w, h1_7_vgs, h1_7_vgs_w, h1_7_vds, h1_7_vds_w, h1_7_T, h1_7_T_w;
    real h1_8, h1_8_w, h1_8_vgs, h1_8_vgs_w, h1_8_vds, h1_8_vds_w, h1_8_T, h1_8_T_w, h2_1, h2_1_w, h2_1_vgs, h2_1_vgs_w;
    real h2_1_vds, h2_1_vds_w, h2_1_T, h2_1_T_w, h2_2, h2_2_w, h2_2_vgs, h2_2_vgs_w, h2_2_vds, h2_2_vds_w, h2_2_T, h2_2_T_w;
    real h2_3, h2_3_w, h2_3_vgs, h2_3_vgs_w, h2_3_vds, h2_3_vds_w, h2_3_T, h2_3_T_w, h2_4, h2_4_w, h2_4_vgs, h2_4_vgs_w;
    real h2_4_vds, h2_4_vds_w, h2_4_T, h2_4_T_w, h2_5, h2_5_w, h2_5_vgs, h2_5_vgs_w, h2_5_vds, h2_5_vds_w, h2_5_T, h2_5_T_w;
    real h2_6, h2_6_w, h2_6_vgs, h2_6_vgs_w, h2_6_vds, h2_6_vds_w, h2_6_T, h2_6_T_w, h2_7, h2_7_w, h2_7_vgs, h2_7_vgs_w;
    real h2_7_vds, h2_7_vds_w, h2_7_T, h2_7_T_w, h2_8, h2_8_w, h2_8_vgs, h2_8_vgs_w, h2_8_vds, h2_8_vds_w, h2_8_T, h2_8_T_w;
    real u, u_w, u_vgs, u_vgs_w, u_vds, u_vds_w, u_T, u_T_w;
    begin
      x1 = (vgs - (-0.9208796670951123))*0.9266806794578499;
      x1_w = w_vgs*0.9266806794578499;
      x2 = (vds - 7.566235437630191)*0.13452134401466356;
      x2_w = w_vds*0.13452134401466356;
      x3 = (T - 64.251518025185)*0.025476721673754595;
      x3_w = w_T*0.025476721673754595;
      // hidden layer 1
      z = -0.3637558756015876 + 0.3453732192212337*x1 - 0.9923288740271166*x2 - 0.001587595315250342*x3;
      zw = 0.3453732192212337*x1_w - 0.9923288740271166*x2_w - 0.001587595315250342*x3_w;
      zg_vgs = 0.3200506894544778;
      zgw_vgs = 0.0;
      zg_vds = -0.13348941383868548;
      zgw_vds = 0.0;
      zg_T = -4.0446723977189646e-05;
      zgw_T = 0.0;
      h1_1 = tanh(z);
      sl = (1.0 - h1_1*h1_1);
      h1_1_w = sl*zw;
      slw = -2.0*h1_1*h1_1_w;
      h1_1_vgs = sl*(zg_vgs);
      h1_1_vgs_w = sl*zgw_vgs + slw*zg_vgs;
      h1_1_vds = sl*(zg_vds);
      h1_1_vds_w = sl*zgw_vds + slw*zg_vds;
      h1_1_T = sl*(zg_T);
      h1_1_T_w = sl*zgw_T + slw*zg_T;
      z = -0.4523139241991508 - 0.010387229619475453*x1 + 0.24241398536256417*x2 - 0.023192819534764087*x3;
      zw = - 0.010387229619475453*x1_w + 0.24241398536256417*x2_w - 0.023192819534764087*x3_w;
      zg_vgs = -0.009625645001460218;
      zgw_vgs = 0.0;
      zg_vds = 0.032609855118923115;
      zgw_vds = 0.0;
      zg_T = -0.0005908770081168032;
      zgw_T = 0.0;
      h1_2 = tanh(z);
      sl = (1.0 - h1_2*h1_2);
      h1_2_w = sl*zw;
      slw = -2.0*h1_2*h1_2_w;
      h1_2_vgs = sl*(zg_vgs);
      h1_2_vgs_w = sl*zgw_vgs + slw*zg_vgs;
      h1_2_vds = sl*(zg_vds);
      h1_2_vds_w = sl*zgw_vds + slw*zg_vds;
      h1_2_T = sl*(zg_T);
      h1_2_T_w = sl*zgw_T + slw*zg_T;
      z = 0.6442247132203237 + 0.16293509387018987*x1 - 0.5944491844924036*x2 - 0.002486632830012602*x3;
      zw = 0.16293509387018987*x1_w - 0.5944491844924036*x2_w - 0.002486632830012602*x3_w;
      zg_vgs = 0.15098880349515612;
      zgw_vgs = 0.0;
      zg_vds = -0.07996610324633883;
      zgw_vds = 0.0;
      zg_T = -6.335125251505178e-05;
      zgw_T = 0.0;
      h1_3 = tanh(z);
      sl = (1.0 - h1_3*h1_3);
      h1_3_w = sl*zw;
      slw = -2.0*h1_3*h1_3_w;
      h1_3_vgs = sl*(zg_vgs);
      h1_3_vgs_w = sl*zgw_vgs + slw*zg_vgs;
      h1_3_vds = sl*(zg_vds);
      h1_3_vds_w = sl*zgw_vds + slw*zg_vds;
      h1_3_T = sl*(zg_T);
      h1_3_T_w = sl*zgw_T + slw*zg_T;
      z = -1.3114370475934891 + 0.02692120073969437*x1 + 0.09253928310735786*x2 + 0.04006380311878135*x3;
      zw = 0.02692120073969437*x1_w + 0.09253928310735786*x2_w + 0.04006380311878135*x3_w;
      zg_vgs = 0.02494735659328115;
      zgw_vgs = 0.0;
      zg_vds = 0.01244850873775523;
      zgw_vds = 0.0;
      zg_T = 0.0010206943612492937;
      zgw_T = 0.0;
      h1_4 = tanh(z);
      sl = (1.0 - h1_4*h1_4);
      h1_4_w = sl*zw;
      slw = -2.0*h1_4*h1_4_w;
      h1_4_vgs = sl*(zg_vgs);
      h1_4_vgs_w = sl*zgw_vgs + slw*zg_vgs;
