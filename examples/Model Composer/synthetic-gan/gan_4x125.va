        e = (u_vgs - cx)*(u_vgs - cx) + (u_vds - cy)*(u_vds - cy);
        if (e < best) begin best = e; bx = cx; by = cy; onedge = interior; ex = (-0.9953871968082156); ey = 0.09593919131555459; end
        t = ((u_vgs - 0.037504845688542135)*(-0.16824602428679386) + (u_vds - 0.4935697181287564)*0.005939079510797307)/0.028341997353748004;
        interior = (t > 0.0 && t < 1.0) ? 1 : 0;
        if (t < 0.0) t = 0.0; else if (t > 1.0) t = 1.0;
        cx = 0.037504845688542135 + t*(-0.16824602428679386);
        cy = 0.4935697181287564 + t*0.005939079510797307;
        e = (u_vgs - cx)*(u_vgs - cx) + (u_vds - cy)*(u_vds - cy);
        if (e < best) begin best = e; bx = cx; by = cy; onedge = interior; ex = (-0.9993775377514109); ey = 0.03527799651237496; end
        t = ((u_vgs - (-0.13074117859825174))*(-0.18393634886175214) + (u_vds - 0.4995087976395537)*0.00048644775735068313)/0.03383281706401282;
        interior = (t > 0.0 && t < 1.0) ? 1 : 0;
        if (t < 0.0) t = 0.0; else if (t > 1.0) t = 1.0;
        cx = (-0.13074117859825174) + t*(-0.18393634886175214);
        cy = 0.4995087976395537 + t*0.00048644775735068313;
        e = (u_vgs - cx)*(u_vgs - cx) + (u_vds - cy)*(u_vds - cy);
        if (e < best) begin best = e; bx = cx; by = cy; onedge = interior; ex = (-0.9999965029244544); ey = 0.0026446434281010055; end
        t = ((u_vgs - (-0.3146775274600039))*(-0.1853224541917186) + (u_vds - 0.4999952453969044)*4.754603095624699e-06)/0.034344412050247894;
        interior = (t > 0.0 && t < 1.0) ? 1 : 0;
        if (t < 0.0) t = 0.0; else if (t > 1.0) t = 1.0;
        cx = (-0.3146775274600039) + t*(-0.1853224541917186);
        cy = 0.4999952453969044 + t*4.754603095624699e-06;
        e = (u_vgs - cx)*(u_vgs - cx) + (u_vds - cy)*(u_vds - cy);
        if (e < best) begin best = e; bx = cx; by = cy; onedge = interior; ex = (-0.999999999670889); ey = 2.5655839249469495e-05; end
        t = ((u_vgs - (-0.4999999816517225))*(-1.834827750846202e-08) + (u_vds - 0.5)*(-0.9752797504736499))/0.9511705916839451;
        interior = (t > 0.0 && t < 1.0) ? 1 : 0;
        if (t < 0.0) t = 0.0; else if (t > 1.0) t = 1.0;
        cx = (-0.4999999816517225) + t*(-1.834827750846202e-08);
        cy = 0.5 + t*(-0.9752797504736499);
        e = (u_vgs - cx)*(u_vgs - cx) + (u_vds - cy)*(u_vds - cy);
        if (e < best) begin best = e; bx = cx; by = cy; onedge = interior; ex = (-1.881334816964166e-08); ey = (-0.9999999999999999); end
        b_vgs = bx;
        b_vds = by;
        if (onedge) begin jgg = ex*ex; jgd = ex*ey; jdd = ey*ey; end
        else begin jgg = 0.0; jgd = 0.0; jdd = 0.0; end
      end
      if (inside && inbox) begin
        xg_Qd = f_Qd(vgs, vds, T, d_vgs, d_vds, d_T);
      end else begin
        p_vgs = (-0.9208796670951123) + 2.1582407449889756*b_vgs;
        p_vds = 7.566235437630191 + 14.867529124463616*b_vds;
        p_T = 64.251518025185 + 78.50303605037001*b_T;
        dist2 = 0.0;
        w_vgs = vgs - p_vgs;
        dist2 = dist2 + (u_vgs - b_vgs)*(u_vgs - b_vgs);
        w_vds = vds - p_vds;
        dist2 = dist2 + (u_vds - b_vds)*(u_vds - b_vds);
        w_T = T - p_T;
        dist2 = dist2 + (u_T - b_T)*(u_T - b_T);
        dist = sqrt(dist2);
        fb = fh_Qd(p_vgs, p_vds, p_T, w_vgs, w_vds, w_T, g_vgs, g_vds, g_T, h_vgs, h_vds, h_T);
        xg_Qd = fb;
        xg_Qd = xg_Qd + g_vgs*w_vgs;
        xg_Qd = xg_Qd + g_vds*w_vds;
        xg_Qd = xg_Qd + g_T*w_T;
        q_vgs = 2.1582407449889756*g_vgs + jgg*2.1582407449889756*h_vgs + jgd*14.867529124463616*h_vds;
        q_vds = 14.867529124463616*g_vds + jgd*2.1582407449889756*h_vgs + jdd*14.867529124463616*h_vds;
        q_T = 78.50303605037001*g_T + j_T*78.50303605037001*h_T;
        d_vgs = q_vgs/2.1582407449889756;
        d_vds = q_vds/14.867529124463616;
        d_T = q_T/78.50303605037001;
      end
    end
  endfunction

  // The intrinsic charge with its temperature and trap inputs held (R-mc27-5): Qg returned, Qd and
  // C = d(Qg, Qd)/d(vgs, vds) written out, in the terminal frame and unscaled.
  analog function real qh;
    input vg, vd, Th, h_phi2;
    output oqd, c11, c12, c21, c22;
    real vg, vd, Th, h_phi2;
    real oqd, c11, c12, c21, c22;
    real e0, e1, ga_T, ga_vds, ga_vgs, gb_T, gb_vds, gb_vgs, ich, qa, qb, qc;
    real qr, ta, tb, ud, ug;
    begin
      ug = vg;
      ud = vd;
      qa = xg_Qg(ug, ud, Th, ga_vgs, ga_vds, ga_T);
      qb = xg_Qd(ug, ud, Th, gb_vgs, gb_vds, gb_T);
      c11 = ga_vgs;
      c12 = ga_vds;
      c21 = gb_vgs;
      c22 = gb_vds;
      oqd = qb;
      qh = qa;
    end
  endfunction

  real kN, Tdev, vgs, vds, ugs, uds, id, igs, igd, qg, qd, swap;
  real T;
  real Tamb, th_rf, th_cf, pw;
  real idd;
  real s_phi2;
  real bq_phi2;
  real bq_T, bq_qg, bq_qd, bq_c11, bq_c12, bq_c21, bq_c22, bq_d0, bq_d1, bq_x, bq_a, bq_b;
  real bq_c, bq_e, bq_i0, bq_i1, bq_i2, bq_i3, bq_r, bq_on, bq_y;
  // the equations' gradients, which the core does not read
  real g_vgs, g_vds, g_T, g_phi2;
  real Cpgi_N, Cpdi_N, Cpdgi_N, rg_N, rd_N, rs_N;

  analog begin
    // Periphery: N fingers of a device measured at N0 = 4
    kN = N/4.0;
    Cpgi_N = Cpgi*(N/4.0);
    Cpdi_N = Cpdi*(N/4.0);
    Cpdgi_N = Cpdgi*(N/4.0);
    rg_N = rg*(4.0/N);
    rd_N = rd*(4.0/N);
    rs_N = rs*(4.0/N);

    // Temperature: the device's own, or the simulator's
    Tdev = (Temp > -273.15) ? Temp : $temperature - `P_CELSIUS0;
    Tamb = min(max(Tdev, 25.0), 125.0);
    @(initial_step) begin
      if (Tdev < 25.0 - 1e-9 || Tdev > 125.0 + 1e-9)
        $warning("gan_4x125.cmodel covers 25.0 to 125.0 degC; the device is at %g degC, so the model is evaluated at %g degC.", Tdev, Tamb);
    end

    // Thermal: Rth x N0/N, its slope taken at the ambient, and Cth x N/N0 - or the instance's own Rth and Cth
    th_rf = (Rth > 0.0) ? Rth/25.0 : (25.0 + 0.0*(Tamb - 25.0))/25.0*(4.0/N);
    th_cf = (Cth > 0.0) ? Cth/4.0000000000000003e-07 : N/4.0;
    T = Tamb + ((SelfHeating) ? potential(ti) : 0.0);
    // the terminal joins ti only when it is wired; left unconnected it is grounded on its own, and the
    // network, which stays on the internal node, keeps heating
    if ($port_connected(t)) potential(t, ti) <+ 0.0;
    else potential(t) <+ 0.0;
    flow(ti) <+ potential(ti)/(25.0*th_rf) + ddt((4.0000000000000003e-07*th_cf)*potential(ti));   // Rth || Cth

    // Network.Netlist
    I(g, s) <+ ddt(Cpga*V(g, s));   // C1
    I(g, d) <+ ddt(Cpdga*V(g, d));   // C4
    I(d, s) <+ ddt(Cpda*V(d, s));   // C6
    V(br_L1) <+ Lg*ddt(I(br_L1));   // L1
    V(br_L1) <+ M_feedback*ddt(I(br_L2));   // M1, coupling L1 to L2
    V(br_L2) <+ Ld*ddt(I(br_L2));   // L2
    V(br_L2) <+ M_feedback*ddt(I(br_L1));   // M1, coupling L2 to L1
    V(br_L3) <+ Ls*ddt(I(br_L3));   // L3
    I(n1, gi) <+ V(n1, gi)/rg_N;   // R1
    I(n3, di) <+ V(n3, di)/rd_N;   // R2
    I(n2, si) <+ V(n2, si)/rs_N;   // R3
    I(n1, n2) <+ ddt(Cpgi_N*V(n1, n2));   // C2
    I(n1, n3) <+ ddt(Cpdgi_N*V(n1, n3));   // C3
    I(n3, n2) <+ ddt(Cpdi_N*V(n3, n2));   // C5

    // The core, on (gi, si) and (di, si), times N/N0
    vgs = V(gi, si);
    vds = V(di, si);
    ugs = vgs;
    uds = vds;
    // Traps: each state its node's voltage, or its DC value at the instantaneous voltages when its lag is off
    s_phi2 = (DrainLag) ? V(phi2) : dc_phi2(vgs, vds, T);
    id = x_Id(ugs, uds, T, s_phi2);
    igs = x_IgGs(ugs, uds, T);
    igd = x_IgGd(ugs, uds, T);
    qg = x_Qg(ugs, uds, T);
    qd = x_Qd(ugs, uds, T);
    if (!(id == id) || abs(id) > 1.0e308)
      $fatal(1, "gan_4x125.cmodel: constituent Id evaluated to %g at vgs=%g, vds=%g, T=%g.", id, ugs, uds, T);
    if (!(igs == igs) || abs(igs) > 1.0e308)
      $fatal(1, "gan_4x125.cmodel: constituent IgGs evaluated to %g at vgs=%g, vds=%g, T=%g.", igs, ugs, uds, T);
    if (!(igd == igd) || abs(igd) > 1.0e308)
      $fatal(1, "gan_4x125.cmodel: constituent IgGd evaluated to %g at vgs=%g, vds=%g, T=%g.", igd, ugs, uds, T);
    if (!(qg == qg) || abs(qg) > 1.0e308)
      $fatal(1, "gan_4x125.cmodel: constituent Qg evaluated to %g at vgs=%g, vds=%g, T=%g.", qg, ugs, uds, T);
    if (!(qd == qd) || abs(qd) > 1.0e308)
      $fatal(1, "gan_4x125.cmodel: constituent Qd evaluated to %g at vgs=%g, vds=%g, T=%g.", qd, ugs, uds, T);

    // The intrinsic charge as the switches have it
    bq_on = (Charge && (LinearC || LinearCgs || LinearCdg || LinearCds || LinearCm)) ? 1.0 : 0.0;
    @(initial_step) begin
      if (Charge && LinearC && (VgsQ <= -1e+300 || VdsQ <= -1e+300))
        $fatal(1, "gan_4x125.cmodel: LinearC=1 needs the bias point, and VgsQ or VdsQ is not set; set VgsQ and VdsQ to the intrinsic gate-source and drain-source voltages at the bias point, in V.");
      else if (Charge && LinearCgs && (VgsQ <= -1e+300 || VdsQ <= -1e+300))
        $fatal(1, "gan_4x125.cmodel: LinearCgs=1 needs the bias point, and VgsQ or VdsQ is not set; set VgsQ and VdsQ to the intrinsic gate-source and drain-source voltages at the bias point, in V.");
      else if (Charge && LinearCdg && (VgsQ <= -1e+300 || VdsQ <= -1e+300))
        $fatal(1, "gan_4x125.cmodel: LinearCdg=1 needs the bias point, and VgsQ or VdsQ is not set; set VgsQ and VdsQ to the intrinsic gate-source and drain-source voltages at the bias point, in V.");
      else if (Charge && LinearCds && (VgsQ <= -1e+300 || VdsQ <= -1e+300))
        $fatal(1, "gan_4x125.cmodel: LinearCds=1 needs the bias point, and VgsQ or VdsQ is not set; set VgsQ and VdsQ to the intrinsic gate-source and drain-source voltages at the bias point, in V.");
      else if (Charge && LinearCm && (VgsQ <= -1e+300 || VdsQ <= -1e+300))
        $fatal(1, "gan_4x125.cmodel: LinearCm=1 needs the bias point, and VgsQ or VdsQ is not set; set VgsQ and VdsQ to the intrinsic gate-source and drain-source voltages at the bias point, in V.");
      if (bq_on > 0.0 && SelfHeating && TjQ <= -273.15)
        $warning("gan_4x125.cmodel: TjQ is not set, so the charge is frozen at the ambient, %g degC, and not at the junction temperature at the bias point; set TjQ to the ambient plus the DC rise.", Tamb);
    end
    if (!Charge) begin
      qg = 0.0;
      qd = 0.0;
    end else if (bq_on > 0.0) begin
      // held at the bias point: its temperature, and every trap state at its DC value there
      bq_T = (TjQ > -273.15) ? TjQ : Tamb;
      bq_phi2 = dc_phi2(VgsQ, VdsQ, bq_T);
      bq_qg = qh(VgsQ, VdsQ, bq_T, bq_phi2, bq_qd, bq_c11, bq_c12, bq_c21, bq_c22);
      bq_d0 = vgs - VgsQ;
      bq_d1 = vds - VdsQ;
      if (LinearC) begin
        // LinearC: q(v_Q) + C(v_Q)*(v - v_Q), in the terminal frame
        qg = bq_qg + bq_c11*bq_d0 + bq_c12*bq_d1;
        qd = bq_qd + bq_c21*bq_d0 + bq_c22*bq_d1;
      end else begin
        // A branch held: the held surface, less each frozen branch's residual along the line from the bias point,
        // r_b = (integral of C_b - C_b(v_Q))*du_b by 8-point Gauss-Legendre
        qg = qh(vgs, vds, bq_T, bq_phi2, qd, bq_a, bq_b, bq_c, bq_e);
        bq_i0 = 0.0;
        bq_i1 = 0.0;
        bq_i2 = 0.0;
        bq_i3 = 0.0;
        bq_y = qh(VgsQ + 0.019855071751231856*bq_d0, VdsQ + 0.019855071751231856*bq_d1, bq_T, bq_phi2, bq_x, bq_a, bq_b, bq_c, bq_e);
        bq_i0 = bq_i0 + 0.05061426814518813*(bq_a + bq_b);
        bq_i1 = bq_i1 + 0.05061426814518813*(-bq_b);
        bq_i2 = bq_i2 + 0.05061426814518813*(bq_e + bq_b);
        bq_i3 = bq_i3 + 0.05061426814518813*(bq_c - bq_b);
        bq_y = qh(VgsQ + 0.10166676129318664*bq_d0, VdsQ + 0.10166676129318664*bq_d1, bq_T, bq_phi2, bq_x, bq_a, bq_b, bq_c, bq_e);
        bq_i0 = bq_i0 + 0.11119051722668724*(bq_a + bq_b);
        bq_i1 = bq_i1 + 0.11119051722668724*(-bq_b);
        bq_i2 = bq_i2 + 0.11119051722668724*(bq_e + bq_b);
        bq_i3 = bq_i3 + 0.11119051722668724*(bq_c - bq_b);
        bq_y = qh(VgsQ + 0.2372337950418355*bq_d0, VdsQ + 0.2372337950418355*bq_d1, bq_T, bq_phi2, bq_x, bq_a, bq_b, bq_c, bq_e);
        bq_i0 = bq_i0 + 0.15685332293894363*(bq_a + bq_b);
        bq_i1 = bq_i1 + 0.15685332293894363*(-bq_b);
        bq_i2 = bq_i2 + 0.15685332293894363*(bq_e + bq_b);
        bq_i3 = bq_i3 + 0.15685332293894363*(bq_c - bq_b);
        bq_y = qh(VgsQ + 0.4082826787521751*bq_d0, VdsQ + 0.4082826787521751*bq_d1, bq_T, bq_phi2, bq_x, bq_a, bq_b, bq_c, bq_e);
        bq_i0 = bq_i0 + 0.181341891689181*(bq_a + bq_b);
        bq_i1 = bq_i1 + 0.181341891689181*(-bq_b);
        bq_i2 = bq_i2 + 0.181341891689181*(bq_e + bq_b);
        bq_i3 = bq_i3 + 0.181341891689181*(bq_c - bq_b);
        bq_y = qh(VgsQ + 0.591717321247825*bq_d0, VdsQ + 0.591717321247825*bq_d1, bq_T, bq_phi2, bq_x, bq_a, bq_b, bq_c, bq_e);
        bq_i0 = bq_i0 + 0.181341891689181*(bq_a + bq_b);
        bq_i1 = bq_i1 + 0.181341891689181*(-bq_b);
        bq_i2 = bq_i2 + 0.181341891689181*(bq_e + bq_b);
        bq_i3 = bq_i3 + 0.181341891689181*(bq_c - bq_b);
        bq_y = qh(VgsQ + 0.7627662049581645*bq_d0, VdsQ + 0.7627662049581645*bq_d1, bq_T, bq_phi2, bq_x, bq_a, bq_b, bq_c, bq_e);
        bq_i0 = bq_i0 + 0.15685332293894363*(bq_a + bq_b);
        bq_i1 = bq_i1 + 0.15685332293894363*(-bq_b);
        bq_i2 = bq_i2 + 0.15685332293894363*(bq_e + bq_b);
        bq_i3 = bq_i3 + 0.15685332293894363*(bq_c - bq_b);
        bq_y = qh(VgsQ + 0.8983332387068134*bq_d0, VdsQ + 0.8983332387068134*bq_d1, bq_T, bq_phi2, bq_x, bq_a, bq_b, bq_c, bq_e);
        bq_i0 = bq_i0 + 0.11119051722668724*(bq_a + bq_b);
        bq_i1 = bq_i1 + 0.11119051722668724*(-bq_b);
        bq_i2 = bq_i2 + 0.11119051722668724*(bq_e + bq_b);
        bq_i3 = bq_i3 + 0.11119051722668724*(bq_c - bq_b);
        bq_y = qh(VgsQ + 0.9801449282487682*bq_d0, VdsQ + 0.9801449282487682*bq_d1, bq_T, bq_phi2, bq_x, bq_a, bq_b, bq_c, bq_e);
        bq_i0 = bq_i0 + 0.05061426814518813*(bq_a + bq_b);
        bq_i1 = bq_i1 + 0.05061426814518813*(-bq_b);
        bq_i2 = bq_i2 + 0.05061426814518813*(bq_e + bq_b);
        bq_i3 = bq_i3 + 0.05061426814518813*(bq_c - bq_b);
        if (LinearCgs) begin
          bq_r = (bq_i0 - (bq_c11 + bq_c12))*(bq_d0);
          qg = qg - bq_r;
        end
        if (LinearCdg) begin
          bq_r = (bq_i1 - (-bq_c12))*(bq_d0 - bq_d1);
          qg = qg - bq_r;
          qd = qd + bq_r;
        end
        if (LinearCds) begin
          bq_r = (bq_i2 - (bq_c22 + bq_c12))*(bq_d1);
          qd = qd - bq_r;
        end
        if (LinearCm) begin
          bq_r = (bq_i3 - (bq_c21 - bq_c12))*(bq_d0);
          qd = qd - bq_r;
        end
      end
    end
    idd = id;
    I(gi, si) <+ kN*(igs + igd);
    I(di, si) <+ kN*(idd - igd);
    I(gi, si) <+ ddt(kN*qg);
    I(di, si) <+ ddt(kN*qd);
    // Trap-state nodes, unscaled: C*dphi/dt = C*rate, C the normalised node capacitance
    if (DrainLag) begin
      I(phi2) <+ ddt(0.001*V(phi2)) - 0.001*r_phi2(V(phi2), vgs, vds, T);
    end else begin
      V(phi2) <+ 0.0;
    end
    // Self-heating: the dissipated power, ig*vgs + id*vds of the scaled currents, flows into ti
    pw = (kN*(igs + igd))*vgs + (kN*(idd - igd))*vds;
    if (SelfHeating) flow(ti) <+ -pw;
  end
endmodule
