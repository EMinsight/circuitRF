      "Parameters": [
        {
          "Name": "Id_ComposedFET",
          "Expression": "DC1.I(\u0022ID1\u0022)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Id_VerilogA",
          "Expression": "DC1.I(\u0022ID2\u0022)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "S21_ComposedFET",
          "Expression": "dB(SP1.S(2,1))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "S21_VerilogA",
          "Expression": "dB(SP1.S(4,3))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pout_W_ComposedFET",
          "Expression": "real(0.5*HB1.V(\u0022o1\u0022,1)*conj(HB1.V(\u0022o1\u0022,1)))/50",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pout_W_VerilogA",
          "Expression": "real(0.5*HB1.V(\u0022o2\u0022,1)*conj(HB1.V(\u0022o2\u0022,1)))/50",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pout_ComposedFET",
          "Expression": "10*log10(Pout_W_ComposedFET*1000)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pout_VerilogA",
          "Expression": "10*log10(Pout_W_VerilogA*1000)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "PAE_ComposedFET",
          "Expression": "(Pout_W_ComposedFET - real(0.5*HB1.V(\u0022a1\u0022,1)*conj(HB1.I(\u0022IIN1\u0022,1))))/real(VDD*HB1.I(\u0022ID1\u0022,0))*100",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "PAE_VerilogA",
          "Expression": "(Pout_W_VerilogA - real(0.5*HB1.V(\u0022a2\u0022,1)*conj(HB1.I(\u0022IIN2\u0022,1))))/real(VDD*HB1.I(\u0022ID2\u0022,0))*100",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    }
