          "Expression": "50",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "K",
          "Expression": "10^(dB/20)        ; voltage ratio of the attenuation",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Rsh",
          "Expression": "Z0*(K\u002B1)/(K-1)    ; shunt arms",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Rse",
          "Expression": "Z0*(K^2-1)/(2*K)  ; series arm",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    },
