    {
      "InstanceName": "MEAS1",
      "Symbol": "Meas",
      "X": 1400,
      "Y": -2300,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "Pin_deliv_W",
          "Expression": "real(0.5*HB1.V(\u0022src\u0022,1)*conj(HB1.I(\u0022Iin\u0022,1)))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pout_W",
          "Expression": "real(0.5*HB1.V(\u0022out\u0022,1)*conj(HB1.V(\u0022out\u0022,1)))/50",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pout_dBm",
          "Expression": "10*log10(Pout_W*1000)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Gt_dB",
          "Expression": "Pout_dBm - Pin",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "PDC_W",
          "Expression": "real(HB1.V(\u0022VDD\u0022,0)*HB1.I(\u0022IDC\u0022,0))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "DE",
          "Expression": "Pout_W/PDC_W*100",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "PAE",
          "Expression": "(Pout_W - Pin_deliv_W)/PDC_W*100",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Tj_rise",
          "Expression": "real(HB1.V(\u0022tj\u0022,0))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    }
